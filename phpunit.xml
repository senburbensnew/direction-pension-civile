<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!-- Isolated from .env dev DB — RefreshDatabase must never wipe local data -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="NOTIFICATIONS_SMS_ENABLED" value="false"/>
        <env name="SMS_DRIVER" value="twilio"/>
        <env name="TWILIO_ACCOUNT_SID" value="ACaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"/>
        <env name="TWILIO_AUTH_TOKEN" value="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"/>
        <env name="TWILIO_FROM" value="+15551234567"/>
        <env name="VONAGE_KEY" value=""/>
        <env name="VONAGE_SECRET" value=""/>
        <env name="VONAGE_SMS_FROM" value=""/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="QUEUE_AFTER_COMMIT" value="false"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="OCR_DRIVER" value="tesseract"/>
    </php>
</phpunit>
