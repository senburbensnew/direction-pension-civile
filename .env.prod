# ========================================
# APP
# ========================================

APP_NAME="Direction Pension Civile"
APP_ENV=production
APP_KEY=base64:C/37i6Boi0euroiRdvtvQ96XbeIysGgfTsmbWN9s5XI=
APP_DEBUG=false
APP_URL=https://dpc.mef.gouv.ht

# ========================================
# LOG
# ========================================

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ========================================
# DATABASE
# ========================================

DB_CONNECTION=sqlite
DB_DATABASE=/home/mefhait1/dpc.mef.gouv.ht/direction-pension-civile/database/database.sqlite # for the prod server
DB_FOREIGN_KEYS=true

# ========================================
# BROADCAST
# ========================================

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ========================================
# MEMCACHED
# ========================================

MEMCACHED_HOST=127.0.0.1

# ========================================
# REDIS
# ========================================

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ========================================
# MAIL
# ========================================

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ========================================
# AWS
# ========================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ========================================
# PUSHER
# ========================================

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# ========================================
# VITE
# ========================================

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ========================================
# GALIPEC
# ========================================

GALIPEC_BASE_URL=
GALIPEC_TOKEN=
GALIPEC_DRIVER=http

# ========================================
# OCR
# ========================================

OCR_DRIVER=google_document_ai
OCR_GOOGLE_CREDENTIALS=storage/app/ocr-dpc-sa.json
OCR_GOOGLE_PROJECT_ID=716725419455
OCR_GOOGLE_LOCATION=us
OCR_GOOGLE_PROCESSOR_ID=f8e74bcc12f0a116
OCR_GOOGLE_DOCUMENT_AI_ENDPOINT=https://us-documentai.googleapis.com

# ========================================
# TWILIO SMS
# ========================================

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+1xxxxxxxxxx

# ========================================
# TIMEZONE
# ========================================

APP_TIMEZONE=America/Port-au-Prince

# ========================================
# SITE UNDER CONSTRUCTION
# ========================================

SITE_UNDER_CONSTRUCTION=true

RDV_VISIO_DOMAIN=kmeet.infomaniak.com
RDV_VISIO_ROOM_PREFIX=dpc