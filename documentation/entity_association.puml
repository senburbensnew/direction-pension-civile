            title
            description
            type
            file_path
            url
            order_column
            published
            created_at
            updated_at
    }

    entity "**mediatheque_items**" as mediatheque_items {
        <b>PK</b>  id
        ---
            title
            description
            type
            file_path
            url
            order_column
            published
            is_featured
            created_at
            updated_at
    }

    entity "**reports**" as reports {
        <b>PK</b>  id
        ---
            title
            year
            description
            file_name
            file_path
            mime_type
            file_size
            status
            published_at
            cover_path
        <b>FK</b>  created_by
            created_at
            updated_at
    }

    entity "**faq_items**" as faq_items {
        <b>PK</b>  id
        ---
            question
            answer
            category
            order_column
            published
            created_at
            updated_at
    }

    entity "**glossaire_terms**" as glossaire_terms {
        <b>PK</b>  id
        ---
            term
            definition
            category
            icon
            order_column
            published
            created_at
            updated_at
    }

    entity "**partenaires**" as partenaires {
        <b>PK</b>  id
        ---
            name
            logo
            website_url
            order
            active
            created_at
            updated_at
    }

    entity "**officials**" as officials {
        <b>PK</b>  id
        ---
            slug
            role
            nom
            sexe
            photo
            biographie
            discours
            citation
            order
            active
            created_at
            updated_at
    }

    entity "**institution_images**" as institution_images {
        <b>PK</b>  id
        ---
            title
            image
            order
            active
            created_at
            updated_at
    }

    entity "**liens_utiles**" as liens_utiles {
        <b>PK</b>  id
        ---
            name
            abbr
            url
            category
            order_column
            published
            created_at
            updated_at
    }

    entity "**direction_departementales**" as direction_departementales {
        <b>PK</b>  id
        ---
            abbr
            nom
            ville
            color
            order
            description
            created_at
            updated_at
    }

    entity "**newsletters**" as newsletters {
        <b>PK</b>  id
        ---
            email
            unsubscribe_token
            created_at
            updated_at
    }

    entity "**newsletter_campaigns**" as newsletter_campaigns {
        <b>PK</b>  id
        ---
            subject
            body
            recipients_count
            sent_at
        <b>FK</b>  sent_by
            created_at
            updated_at
    }
}

' ═══════════════════════════════════════════════════════════════
'  CONTACT, STATS, TECHNIQUE, LEGACY
' ═══════════════════════════════════════════════════════════════
package "Contact, stats et technique" {
    entity "**contact_subjects**" as contact_subjects {
        <b>PK</b>  id
        ---
            slug
            label
            position
            is_active
            allows_custom
            created_at
            updated_at
    }

    entity "**contacts**" as contacts {
        <b>PK</b>  id
        ---
            first_name
            last_name
            email
            telephone
            subject
            destinataire
            message
            read
            created_at
            updated_at
    }

    entity "**site_visits**" as site_visits {
        <b>PK</b>  id
        ---
            visited_on
            hits
            visitors
            created_at
            updated_at
    }

    entity "**site_visit_ips**" as site_visit_ips {
        <b>PK</b>  id
        ---
            visited_on
            ip_hash
            created_at
            updated_at
    }

    entity "**parameters**" as parameters {
        <b>PK</b>  id
        ---
            name
            description
            value
            created_at
            updated_at
    }

    entity "**activity_log**" as activity_log {
        <b>PK</b>  id
        ---
            log_name
            description
            subject_type
            subject_id
            causer_type
            causer_id
            properties
            event
            batch_uuid
            created_at
            updated_at
    }

    entity "**error_logs**" as error_logs {
        <b>PK</b>  id
        ---
            message
            code
            file
            line
            trace
            request_data
        <b>FK</b>  user_id
            created_at
            updated_at
    }

    entity "**request_types**" as request_types {
        <b>PK</b>  id
        ---
            code
            name
            description
            created_at
            updated_at
    }

    entity "**request_histories**" as request_histories {
        <b>PK</b>  id
        ---
            request_id
            request_type
            request_data
            event_type
            event_date
        <b>FK</b>  created_by
            created_at
            updated_at
    }

    entity "**failed_jobs**" as failed_jobs {
        <b>PK</b>  id
        ---
            uuid
            connection
            queue
            payload
            exception
            failed_at
    }

    entity "**migrations**" as migrations {
        <b>PK</b>  id
        ---
            migration
            batch
    }
}

