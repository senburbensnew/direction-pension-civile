@startuml entity_association
!theme plain
skinparam linetype ortho
skinparam roundcorner 8
skinparam shadowing false
skinparam backgroundColor #FAFAFA
skinparam packageStyle rectangle

skinparam entity {
    BackgroundColor #FFFFFF
    BorderColor #4A90D9
    HeaderBackgroundColor #4A90D9
    HeaderFontColor #FFFFFF
    FontColor #333333
    FontSize 11
}

skinparam arrow {
    Color #666666
    FontColor #555555
    FontSize 10
}

title <b>Diagramme Entité-Association</b>\nSchéma actuel (SQLite locale, 58 tables)

' ═══════════════════════════════════════════════════════════════
'  IDENTITÉ, RÉFÉRENTIELS UTILISATEUR, HABILITATIONS
' ═══════════════════════════════════════════════════════════════
package "Identité et habilitations" {
    entity "**users**" as users {
        <b>PK</b>  id
        ---
            name
            email
            email_verified_at
            password
            remember_token
            nif
            pension_code
            ninu
            firstname
            lastname
            birth_date
            phone
            address
            profile_photo
            signature
            is_active
        <b>FK</b>  user_type_id
        <b>FK</b>  service_id
        <b>FK</b>  gender_id
        <b>FK</b>  civil_status_id
            created_at
            updated_at
    }

    entity "**user_types**" as user_types {
        <b>PK</b>  id
        ---
            name
            created_at
            updated_at
    }

    entity "**genders**" as genders {
        <b>PK</b>  id
        ---
            name
            created_at
            updated_at
    }

    entity "**civil_statuses**" as civil_statuses {
        <b>PK</b>  id
        ---
            name
            description
            created_at
            updated_at
    }

    entity "**roles**" as roles {
        <b>PK</b>  id
        ---
            name
            guard_name
            created_at
            updated_at
    }

    entity "**permissions**" as permissions {
        <b>PK</b>  id
        ---
            name
            guard_name
            created_at
            updated_at
    }

    entity "**model_has_roles**" as model_has_roles {
        <b>PK</b>  id
        ---
            model_type
            model_id
        <b>FK</b>  role_id
            created_at
            updated_at
    }

    entity "**model_has_permissions**" as model_has_permissions {
        <b>PK</b>  id
        ---
            model_type
            model_id
        <b>FK</b>  permission_id
            created_at
            updated_at
    }

    entity "**role_has_permissions**" as role_has_permissions {
        <b>PK</b>  id
        ---
        <b>FK</b>  role_id
        <b>FK</b>  permission_id
            created_at
            updated_at
    }

    entity "**password_reset_tokens**" as password_reset_tokens {
        <b>PK</b>  email
        ---
            token
            created_at
    }

    entity "**personal_access_tokens**" as personal_access_tokens {
        <b>PK</b>  id
        ---
            tokenable_type
            tokenable_id
            name
            token
            abilities
            last_used_at
            expires_at
            created_at
            updated_at
    }

    entity "**notifications**" as notifications {
        <b>PK</b>  id
        ---
            type
            notifiable_type
            notifiable_id
            data
            read_at
            created_at
    }

    entity "**pension_types**" as pension_types {
        <b>PK</b>  id
        ---
            name
            description
            created_at
            updated_at
    }

    entity "**pension_categories**" as pension_categories {
        <b>PK</b>  id
        ---
            name
            description
            created_at
            updated_at
    }
}

' ═══════════════════════════════════════════════════════════════
'  DOSSIERS, CIRCUIT, SERVICES
' ═══════════════════════════════════════════════════════════════
package "Dossiers et circuit de traitement" {
    entity "**services**" as services {
        <b>PK</b>  id
        ---
            code
            nom
            description
            icon
            color
            created_at
            updated_at
    }

    entity "**types_demandes**" as types_demandes {
        <b>PK</b>  id
        ---
            code
            label
            description
            active
            created_at
            updated_at
    }

    entity "**demandes**" as demandes {
        <b>PK</b>  id
        ---
            code
            title
            type
            data
            submitted_at
            expires_at
            annotation
            annotated_at
            folder
            categorie
            is_urgent
        <b>FK</b>  created_by
        <b>FK</b>  current_service_id
        <b>FK</b>  current_step_id
        <b>FK</b>  annotated_by
            created_at
            updated_at
    }

    entity "**workflow_steps**" as workflow_steps {
        <b>PK</b>  id
        ---
            code
            nom
            description
            ordre
            type_demande
            type_noeud
        <b>FK</b>  service_id
            created_at
            updated_at
    }

    entity "**workflow_step_transitions**" as workflow_step_transitions {
        <b>PK</b>  id
        ---
        <b>FK</b>  from_step_id
        <b>FK</b>  to_step_id
            action
            is_urgent_only
            ordre
            required_permission
            guard_conditions
            created_at
            updated_at
    }

    entity "**demande_circuit_snapshots**" as demande_circuit_snapshots {
        <b>PK</b>  id
        ---
        <b>FK</b>  demande_id
            snapshot
            created_at
            updated_at
    }

    entity "**demande_interactions**" as demande_interactions {
        <b>PK</b>  id
        ---
        <b>FK</b>  demande_id
            type
        <b>FK</b>  from_service_id
        <b>FK</b>  to_service_id
        <b>FK</b>  to_step_id
        <b>FK</b>  initiated_by
            commentaire
            statut
            reponse
            repondu_at
        <b>FK</b>  repondu_by
            created_at
            updated_at
    }

    entity "**demande_histories**" as demande_histories {
        <b>PK</b>  id
        ---
        <b>FK</b>  demande_id
            statut
            commentaire
            event
            champs
        <b>FK</b>  changed_by
            created_at
            updated_at
    }

    entity "**demande_messages**" as demande_messages {
        <b>PK</b>  id
        ---
        <b>FK</b>  demande_id
        <b>FK</b>  sender_id
            body
            read_at
            created_at
            updated_at
    }

    entity "**demande_activity_logs**" as demande_activity_logs {
        <b>PK</b>  id
        ---
        <b>FK</b>  demande_id
        <b>FK</b>  user_id
            action
            metadata
            created_at
            updated_at
    }

    entity "**assignments**" as assignments {
        <b>PK</b>  id
        ---
        <b>FK</b>  demande_id
        <b>FK</b>  user_id
        <b>FK</b>  assigned_by
            note
            ended_at
            created_at
            updated_at
    }

    entity "**media**" as media {
        <b>PK</b>  id
        ---
            model_type
            model_id
            uuid
            collection_name
            name
            file_name
            mime_type
            disk
            conversions_disk
            size
            manipulations
            custom_properties
            generated_conversions
            responsive_images
            order_column
            created_at
            updated_at
    }

    entity "**required_circuit_services**" as required_circuit_services {
        <b>PK</b>  id
        ---
        <b>FK</b>  service_id
            type_demande
            created_at
            updated_at
    }

    entity "**step_required_documents**" as step_required_documents {
        <b>PK</b>  id
        ---
        <b>FK</b>  service_id
        <b>FK</b>  workflow_step_id
            type_demande
            label
            document_type
            created_at
            updated_at
    }

    entity "**service_sla**" as service_sla {
        <b>PK</b>  id
        ---
        <b>FK</b>  service_id
            type_demande
            delai_jours
            created_at
            updated_at
    }

    entity "**agent_delegations**" as agent_delegations {
        <b>PK</b>  id
        ---
        <b>FK</b>  delegating_user_id
        <b>FK</b>  delegate_user_id
        <b>FK</b>  service_id
            start_date
            end_date
            active
            created_at
            updated_at
    }

    entity "**flux_transition_logs**" as flux_transition_logs {
        <b>PK</b>  id
        ---
        <b>FK</b>  user_id
            action
            flux_transition_id
            before
            after
            created_at
            updated_at
    }
}

