<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_Modification"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.50.1"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_Modification">
    <bpmn:participant id="Participant_Modification" name="Direction de la Pension Civile" processRef="Process_Modification" />
    <bpmn:textAnnotation id="TextAnnotation_Modification">
      <bpmn:text>Pièces : 1 photo, Carte de pension, Matricule fiscal, CINU, Formulaire de demande de modification</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Modification" sourceRef="Activity_Soumettre_Modification" targetRef="TextAnnotation_Modification" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Modification" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Modification">
      <bpmn:lane id="Lane_Pensionne" name="Pensionné">
        <bpmn:flowNodeRef>StartEvent_Modification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Soumettre_Modification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Notification_Modification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Modification</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Secretariat" name="Secrétariat">
        <bpmn:flowNodeRef>Activity_Reception_Secretariat_Modification</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Direction" name="Direction">
        <bpmn:flowNodeRef>Activity_Annotation_Direction_Modification</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ServiceCompta" name="Service Comptabilité">
        <bpmn:flowNodeRef>Activity_Traitement_Compta_Modification</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SecretariatCompta" name="Secrétariat Comptabilité">
        <bpmn:flowNodeRef>Activity_Reception_Compta_Modification</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ChefService" name="Chef de service">
        <bpmn:flowNodeRef>Activity_Annotation_Chef_Modification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Dispatching_Modification</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Agent">
        <bpmn:flowNodeRef>Activity_Verification_Modification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Validation_Modification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Saisie_Syspens_Modification</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Modification" name="Soumission">
      <bpmn:outgoing>Flow_Start_To_Soumettre_Modification</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Activity_Soumettre_Modification" name="Soumettre demande">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_Soumettre_Modification</bpmn:incoming>
      <bpmn:outgoing>Flow_Soumettre_To_ReceptionSec_Modification</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:receiveTask id="Activity_Reception_Secretariat_Modification" name="Réception Secrétariat">
      <bpmn:incoming>Flow_Soumettre_To_ReceptionSec_Modification</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceptionSec_To_AnnotationDir_Modification</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:userTask id="Activity_Annotation_Direction_Modification" name="Annotation Direction">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_ReceptionSec_To_AnnotationDir_Modification</bpmn:incoming>
      <bpmn:outgoing>Flow_AnnotationDir_To_TraitementCompta_Modification</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Activity_Traitement_Compta_Modification" name="Traitement Service Comptabilité">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_AnnotationDir_To_TraitementCompta_Modification</bpmn:incoming>
      <bpmn:outgoing>Flow_TraitementCompta_To_ReceptionCompta_Modification</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:receiveTask id="Activity_Reception_Compta_Modification" name="Réception Secrétariat Comptabilité">
      <bpmn:incoming>Flow_TraitementCompta_To_ReceptionCompta_Modification</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceptionCompta_To_AnnotationChef_Modification</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:userTask id="Activity_Annotation_Chef_Modification" name="Annotation Chef de service">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_ReceptionCompta_To_AnnotationChef_Modification</bpmn:incoming>
      <bpmn:outgoing>Flow_AnnotationChef_To_Dispatching_Modification</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Activity_Dispatching_Modification" name="Dispatching">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_AnnotationChef_To_Dispatching_Modification</bpmn:incoming>
      <bpmn:outgoing>Flow_Dispatching_To_Verification_Modification</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Activity_Verification_Modification" name="Vérification dossier">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Dispatching_To_Verification_Modification</bpmn:incoming>
      <bpmn:outgoing>Flow_Verification_To_Validation_Modification</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Activity_Validation_Modification" name="Validation requête">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Verification_To_Validation_Modification</bpmn:incoming>
      <bpmn:outgoing>Flow_Validation_To_Saisie_Modification</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Activity_Saisie_Syspens_Modification" name="Saisie sur SYSPENS">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Validation_To_Saisie_Modification</bpmn:incoming>
      <bpmn:outgoing>Flow_Saisie_To_Notification_Modification</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Activity_Notification_Modification" name="Notifier pensionné">
      <bpmn:incoming>Flow_Saisie_To_Notification_Modification</bpmn:incoming>
      <bpmn:outgoing>Flow_Notification_To_End_Modification</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Modification" name="FIN">
      <bpmn:incoming>Flow_Notification_To_End_Modification</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_Start_To_Soumettre_Modification" sourceRef="StartEvent_Modification" targetRef="Activity_Soumettre_Modification" />
    <bpmn:sequenceFlow id="Flow_Soumettre_To_ReceptionSec_Modification" sourceRef="Activity_Soumettre_Modification" targetRef="Activity_Reception_Secretariat_Modification" />
    <bpmn:sequenceFlow id="Flow_ReceptionSec_To_AnnotationDir_Modification" sourceRef="Activity_Reception_Secretariat_Modification" targetRef="Activity_Annotation_Direction_Modification" />
    <bpmn:sequenceFlow id="Flow_AnnotationDir_To_TraitementCompta_Modification" sourceRef="Activity_Annotation_Direction_Modification" targetRef="Activity_Traitement_Compta_Modification" />
    <bpmn:sequenceFlow id="Flow_TraitementCompta_To_ReceptionCompta_Modification" sourceRef="Activity_Traitement_Compta_Modification" targetRef="Activity_Reception_Compta_Modification" />
    <bpmn:sequenceFlow id="Flow_ReceptionCompta_To_AnnotationChef_Modification" sourceRef="Activity_Reception_Compta_Modification" targetRef="Activity_Annotation_Chef_Modification" />
    <bpmn:sequenceFlow id="Flow_AnnotationChef_To_Dispatching_Modification" sourceRef="Activity_Annotation_Chef_Modification" targetRef="Activity_Dispatching_Modification" />
    <bpmn:sequenceFlow id="Flow_Dispatching_To_Verification_Modification" sourceRef="Activity_Dispatching_Modification" targetRef="Activity_Verification_Modification" />
    <bpmn:sequenceFlow id="Flow_Verification_To_Validation_Modification" sourceRef="Activity_Verification_Modification" targetRef="Activity_Validation_Modification" />
    <bpmn:sequenceFlow id="Flow_Validation_To_Saisie_Modification" sourceRef="Activity_Validation_Modification" targetRef="Activity_Saisie_Syspens_Modification" />
    <bpmn:sequenceFlow id="Flow_Saisie_To_Notification_Modification" sourceRef="Activity_Saisie_Syspens_Modification" targetRef="Activity_Notification_Modification" />
    <bpmn:sequenceFlow id="Flow_Notification_To_End_Modification" sourceRef="Activity_Notification_Modification" targetRef="EndEvent_Modification" />

  </bpmn:process>

  <!-- BPMN Diagram -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_Modification">
    <bpmndi:BPMNPlane id="BPMNPlane_Modification" bpmnElement="Collaboration_Modification">
      <bpmndi:BPMNShape id="Participant_Modification_di" bpmnElement="Participant_Modification" isHorizontal="true">
        <dc:Bounds x="160" y="560" width="1400" height="760" />
      </bpmndi:BPMNShape>
      <!-- Lanes -->
      <bpmndi:BPMNShape id="Lane_Pensionne_di_Modification" bpmnElement="Lane_Pensionne" isHorizontal="true">
        <dc:Bounds x="190" y="560" width="1370" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Secretariat_di_Modification" bpmnElement="Lane_Secretariat" isHorizontal="true">
        <dc:Bounds x="190" y="660" width="1370" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Direction_di_Modification" bpmnElement="Lane_Direction" isHorizontal="true">
        <dc:Bounds x="190" y="760" width="1370" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ServiceCompta_di_Modification" bpmnElement="Lane_ServiceCompta" isHorizontal="true">
        <dc:Bounds x="190" y="860" width="1370" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SecretariatCompta_di_Modification" bpmnElement="Lane_SecretariatCompta" isHorizontal="true">
        <dc:Bounds x="190" y="960" width="1370" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ChefService_di_Modification" bpmnElement="Lane_ChefService" isHorizontal="true">
        <dc:Bounds x="190" y="1060" width="1370" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Agent_di_Modification" bpmnElement="Lane_Agent" isHorizontal="true">
        <dc:Bounds x="190" y="1160" width="1370" height="100" />
      </bpmndi:BPMNShape>

      <!-- Formes -->
      <bpmndi:BPMNShape id="StartEvent_Modification_di" bpmnElement="StartEvent_Modification">
        <dc:Bounds x="252" y="592" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="235" y="635" width="73" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Soumettre_Modification_di" bpmnElement="Activity_Soumettre_Modification">
        <dc:Bounds x="380" y="570" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Reception_Secretariat_Modification_di" bpmnElement="Activity_Reception_Secretariat_Modification">
        <dc:Bounds x="380" y="670" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Annotation_Direction_Modification_di" bpmnElement="Activity_Annotation_Direction_Modification">
        <dc:Bounds x="380" y="770" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Traitement_Compta_Modification_di" bpmnElement="Activity_Traitement_Compta_Modification">
        <dc:Bounds x="380" y="870" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Reception_Compta_Modification_di" bpmnElement="Activity_Reception_Compta_Modification">
        <dc:Bounds x="380" y="970" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Annotation_Chef_Modification_di" bpmnElement="Activity_Annotation_Chef_Modification">
        <dc:Bounds x="380" y="1070" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Dispatching_Modification_di" bpmnElement="Activity_Dispatching_Modification">
        <dc:Bounds x="560" y="1070" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Verification_Modification_di" bpmnElement="Activity_Verification_Modification">
        <dc:Bounds x="560" y="1170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Validation_Modification_di" bpmnElement="Activity_Validation_Modification">
        <dc:Bounds x="740" y="1170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Saisie_Syspens_Modification_di" bpmnElement="Activity_Saisie_Syspens_Modification">
        <dc:Bounds x="920" y="1170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Notification_Modification_di" bpmnElement="Activity_Notification_Modification">
        <dc:Bounds x="1100" y="570" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Modification_di" bpmnElement="EndEvent_Modification">
        <dc:Bounds x="1290" y="592" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1295" y="635" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_Modification_di" bpmnElement="TextAnnotation_Modification">
        <dc:Bounds x="530" y="80" width="200" height="100" />
      </bpmndi:BPMNShape>

      <!-- Arêtes -->
      <bpmndi:BPMNEdge id="Flow_Start_To_Soumettre_Modification_di" bpmnElement="Flow_Start_To_Soumettre_Modification">
        <di:waypoint x="288" y="610" /><di:waypoint x="380" y="610" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Soumettre_To_ReceptionSec_Modification_di" bpmnElement="Flow_Soumettre_To_ReceptionSec_Modification">
        <di:waypoint x="430" y="650" /><di:waypoint x="430" y="670" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReceptionSec_To_AnnotationDir_Modification_di" bpmnElement="Flow_ReceptionSec_To_AnnotationDir_Modification">
        <di:waypoint x="430" y="750" /><di:waypoint x="430" y="770" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AnnotationDir_To_TraitementCompta_Modification_di" bpmnElement="Flow_AnnotationDir_To_TraitementCompta_Modification">
        <di:waypoint x="430" y="850" /><di:waypoint x="430" y="870" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TraitementCompta_To_ReceptionCompta_Modification_di" bpmnElement="Flow_TraitementCompta_To_ReceptionCompta_Modification">
        <di:waypoint x="430" y="950" /><di:waypoint x="430" y="970" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReceptionCompta_To_AnnotationChef_Modification_di" bpmnElement="Flow_ReceptionCompta_To_AnnotationChef_Modification">
        <di:waypoint x="430" y="1050" /><di:waypoint x="430" y="1070" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AnnotationChef_To_Dispatching_Modification_di" bpmnElement="Flow_AnnotationChef_To_Dispatching_Modification">
        <di:waypoint x="480" y="1110" /><di:waypoint x="560" y="1110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Dispatching_To_Verification_Modification_di" bpmnElement="Flow_Dispatching_To_Verification_Modification">
        <di:waypoint x="610" y="1150" /><di:waypoint x="610" y="1170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Verification_To_Validation_Modification_di" bpmnElement="Flow_Verification_To_Validation_Modification">
        <di:waypoint x="660" y="1210" /><di:waypoint x="740" y="1210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Validation_To_Saisie_Modification_di" bpmnElement="Flow_Validation_To_Saisie_Modification">
        <di:waypoint x="840" y="1210" /><di:waypoint x="920" y="1210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Saisie_To_Notification_Modification_di" bpmnElement="Flow_Saisie_To_Notification_Modification">
        <di:waypoint x="970" y="1170" /><di:waypoint x="970" y="610" /><di:waypoint x="1100" y="610" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Notification_To_End_Modification_di" bpmnElement="Flow_Notification_To_End_Modification">
        <di:waypoint x="1200" y="610" /><di:waypoint x="1290" y="610" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_Modification_di" bpmnElement="Association_Modification">
        <di:waypoint x="430" y="570" /><di:waypoint x="530" y="130" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>