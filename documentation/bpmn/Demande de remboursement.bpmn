<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Remboursement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_Remboursement">
    <bpmn:participant id="Participant_Remboursement" name="Direction de la Pension Civile" processRef="Process_Remboursement" />
    <bpmn:textAnnotation id="TextAnnotation_Remboursement">
      <bpmn:text>Demande de remboursement – Pièces : identiques à une demande de pension + formulaire de remboursement</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Remboursement" sourceRef="Activity_Soumettre_Remboursement" targetRef="TextAnnotation_Remboursement" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Remboursement" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Remboursement">
      <bpmn:lane id="Lane_SLP" name="SLP (Liquidation)">
        <bpmn:flowNodeRef>Activity_Transmission_SLP_Remboursement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Direction" name="Direction DPC">
        <bpmn:flowNodeRef>Activity_Annotation_Directeur_Remboursement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Agent DPC">
        <bpmn:flowNodeRef>Activity_Verification_Remboursement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Numero_Reception_Remboursement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Transfert_DPC_Remboursement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CourrierMEF" name="Service Courrier MEF">
        <bpmn:flowNodeRef>Activity_Depot_Courrier_Remboursement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Usager" name="Usager / Institution">
        <bpmn:flowNodeRef>StartEvent_Remboursement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Soumettre_Remboursement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Remboursement</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Remboursement" name="Demande de remboursement">
      <bpmn:outgoing>Flow_Start_To_Soumettre_Remboursement</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_Soumettre_Remboursement" name="Soumettre la demande">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_Soumettre_Remboursement</bpmn:incoming>
      <bpmn:outgoing>Flow_Soumettre_To_Depot_Courrier_Remboursement</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="Activity_Depot_Courrier_Remboursement" name="Dépôt au Service courrier MEF">
      <bpmn:incoming>Flow_Soumettre_To_Depot_Courrier_Remboursement</bpmn:incoming>
      <bpmn:outgoing>Flow_DepotCourrier_To_Verification_Remboursement</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Activity_Verification_Remboursement" name="Vérification par l&#39;agent">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DepotCourrier_To_Verification_Remboursement</bpmn:incoming>
      <bpmn:outgoing>Flow_Verification_To_NumeroReception_Remboursement</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_Numero_Reception_Remboursement" name="Attribution du numéro de réception">
      <bpmn:incoming>Flow_Verification_To_NumeroReception_Remboursement</bpmn:incoming>
      <bpmn:outgoing>Flow_NumeroReception_To_TransfertDPC_Remboursement</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_Transfert_DPC_Remboursement" name="Transfert du dossier à la DPC">
      <bpmn:incoming>Flow_NumeroReception_To_TransfertDPC_Remboursement</bpmn:incoming>
      <bpmn:outgoing>Flow_TransfertDPC_To_AnnotationDirecteur_Remboursement</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_Annotation_Directeur_Remboursement" name="Annotation Directeur">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TransfertDPC_To_AnnotationDirecteur_Remboursement</bpmn:incoming>
      <bpmn:outgoing>Flow_AnnotationDirecteur_To_TransmissionSLP_Remboursement</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_Transmission_SLP_Remboursement" name="Transmission au SLP pour liquidation">
      <bpmn:incoming>Flow_AnnotationDirecteur_To_TransmissionSLP_Remboursement</bpmn:incoming>
      <bpmn:outgoing>Flow_TransmissionSLP_To_End_Remboursement</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Remboursement" name="FIN">
      <bpmn:incoming>Flow_TransmissionSLP_To_End_Remboursement</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_To_Soumettre_Remboursement" sourceRef="StartEvent_Remboursement" targetRef="Activity_Soumettre_Remboursement" />
    <bpmn:sequenceFlow id="Flow_Soumettre_To_Depot_Courrier_Remboursement" sourceRef="Activity_Soumettre_Remboursement" targetRef="Activity_Depot_Courrier_Remboursement" />
    <bpmn:sequenceFlow id="Flow_DepotCourrier_To_Verification_Remboursement" sourceRef="Activity_Depot_Courrier_Remboursement" targetRef="Activity_Verification_Remboursement" />
    <bpmn:sequenceFlow id="Flow_Verification_To_NumeroReception_Remboursement" sourceRef="Activity_Verification_Remboursement" targetRef="Activity_Numero_Reception_Remboursement" />
    <bpmn:sequenceFlow id="Flow_NumeroReception_To_TransfertDPC_Remboursement" sourceRef="Activity_Numero_Reception_Remboursement" targetRef="Activity_Transfert_DPC_Remboursement" />
    <bpmn:sequenceFlow id="Flow_TransfertDPC_To_AnnotationDirecteur_Remboursement" sourceRef="Activity_Transfert_DPC_Remboursement" targetRef="Activity_Annotation_Directeur_Remboursement" />
    <bpmn:sequenceFlow id="Flow_AnnotationDirecteur_To_TransmissionSLP_Remboursement" sourceRef="Activity_Annotation_Directeur_Remboursement" targetRef="Activity_Transmission_SLP_Remboursement" />
    <bpmn:sequenceFlow id="Flow_TransmissionSLP_To_End_Remboursement" sourceRef="Activity_Transmission_SLP_Remboursement" targetRef="EndEvent_Remboursement" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Remboursement">
    <bpmndi:BPMNPlane id="BPMNPlane_Remboursement" bpmnElement="Collaboration_Remboursement">
      <bpmndi:BPMNShape id="Participant_Remboursement_di" bpmnElement="Participant_Remboursement" isHorizontal="true">
        <dc:Bounds x="160" y="230" width="1500" height="620" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SLP_di" bpmnElement="Lane_SLP" isHorizontal="true">
        <dc:Bounds x="190" y="590" width="1470" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Direction_di" bpmnElement="Lane_Direction" isHorizontal="true">
        <dc:Bounds x="190" y="510" width="1470" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Agent_di" bpmnElement="Lane_Agent" isHorizontal="true">
        <dc:Bounds x="190" y="410" width="1470" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CourrierMEF_di" bpmnElement="Lane_CourrierMEF" isHorizontal="true">
        <dc:Bounds x="190" y="330" width="1470" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Usager_di" bpmnElement="Lane_Usager" isHorizontal="true">
        <dc:Bounds x="190" y="230" width="1470" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Remboursement_di" bpmnElement="StartEvent_Remboursement">
        <dc:Bounds x="252" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="233" y="305" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Soumettre_Remboursement_di" bpmnElement="Activity_Soumettre_Remboursement">
        <dc:Bounds x="380" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Depot_Courrier_Remboursement_di" bpmnElement="Activity_Depot_Courrier_Remboursement">
        <dc:Bounds x="380" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Verification_Remboursement_di" bpmnElement="Activity_Verification_Remboursement">
        <dc:Bounds x="380" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Numero_Reception_Remboursement_di" bpmnElement="Activity_Numero_Reception_Remboursement">
        <dc:Bounds x="560" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Transfert_DPC_Remboursement_di" bpmnElement="Activity_Transfert_DPC_Remboursement">
        <dc:Bounds x="740" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Annotation_Directeur_Remboursement_di" bpmnElement="Activity_Annotation_Directeur_Remboursement">
        <dc:Bounds x="920" y="520" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Transmission_SLP_Remboursement_di" bpmnElement="Activity_Transmission_SLP_Remboursement">
        <dc:Bounds x="1100" y="600" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Remboursement_di" bpmnElement="EndEvent_Remboursement">
        <dc:Bounds x="1280" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1285" y="305" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_To_Soumettre_Remboursement_di" bpmnElement="Flow_Start_To_Soumettre_Remboursement">
        <di:waypoint x="288" y="280" />
        <di:waypoint x="380" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Soumettre_To_Depot_Courrier_Remboursement_di" bpmnElement="Flow_Soumettre_To_Depot_Courrier_Remboursement">
        <di:waypoint x="430" y="320" />
        <di:waypoint x="430" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DepotCourrier_To_Verification_Remboursement_di" bpmnElement="Flow_DepotCourrier_To_Verification_Remboursement">
        <di:waypoint x="430" y="410" />
        <di:waypoint x="430" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Verification_To_NumeroReception_Remboursement_di" bpmnElement="Flow_Verification_To_NumeroReception_Remboursement">
        <di:waypoint x="480" y="460" />
        <di:waypoint x="560" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NumeroReception_To_TransfertDPC_Remboursement_di" bpmnElement="Flow_NumeroReception_To_TransfertDPC_Remboursement">
        <di:waypoint x="660" y="460" />
        <di:waypoint x="740" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TransfertDPC_To_AnnotationDirecteur_Remboursement_di" bpmnElement="Flow_TransfertDPC_To_AnnotationDirecteur_Remboursement">
        <di:waypoint x="790" y="500" />
        <di:waypoint x="790" y="560" />
        <di:waypoint x="920" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AnnotationDirecteur_To_TransmissionSLP_Remboursement_di" bpmnElement="Flow_AnnotationDirecteur_To_TransmissionSLP_Remboursement">
        <di:waypoint x="970" y="600" />
        <di:waypoint x="970" y="655" />
        <di:waypoint x="1100" y="655" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TransmissionSLP_To_End_Remboursement_di" bpmnElement="Flow_TransmissionSLP_To_End_Remboursement">
        <di:waypoint x="1200" y="640" />
        <di:waypoint x="1200" y="280" />
        <di:waypoint x="1280" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_Remboursement_di" bpmnElement="Association_Remboursement">
        <di:waypoint x="450" y="240" />
        <di:waypoint x="530" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="TextAnnotation_Remboursement_di" bpmnElement="TextAnnotation_Remboursement">
        <dc:Bounds x="530" y="80" width="240" height="100" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
