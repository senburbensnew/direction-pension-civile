<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Reclamation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_Reclamation">
    <bpmn:participant id="Participant_Reclamation" name="Direction de la Pension Civile" processRef="Process_Reclamation" />
    <bpmn:textAnnotation id="TextAnnotation_0vl77nw">
      <bpmn:text>1) Carte de pension 
2) Matricule fiscal
3) Fiche de dépôt /Attestation de bancaire indiquant clairement le titulaire du compte et le numéro de et le type de compte
4) Relevé de compte pour la période indiquée
5) Certificat de perte de document bancaire (livret, carte,..) délivré par la Police.
6) Formulaire de demande de réclamation de virement pour non-réception</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_05fis0u" associationDirection="None" sourceRef="Activity_Soumettre" targetRef="TextAnnotation_0vl77nw" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Reclamation" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Reclamation">
      <bpmn:lane id="Lane_Direction" name="Direction">
        <bpmn:flowNodeRef>Activity_Valider</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Agent de service">
        <bpmn:flowNodeRef>Activity_Verifier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Paiement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Refus</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Chef" name="Chef de service">
        <bpmn:flowNodeRef>Activity_Dispatching</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Annoter</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Secretariat" name="Secrétariat Comptabilité">
        <bpmn:flowNodeRef>Activity_Recevoir</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pensionne" name="Pensionné">
        <bpmn:flowNodeRef>StartEvent_Reclamation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Soumettre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1sf18rz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Notification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Reclamation" name="Soumission de réclamation">
      <bpmn:outgoing>Flow_Start_To_Soumettre</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_Soumettre" name="Soumettre réclamation">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_Soumettre</bpmn:incoming>
      <bpmn:outgoing>Flow_Soumettre_To_Recevoir</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_Valider" name="Valider">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Verifier_To_Valider</bpmn:incoming>
      <bpmn:outgoing>Flow_Valider_To_Decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_Dispatching" name="Dispatching">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Annoter_To_Dispatching</bpmn:incoming>
      <bpmn:outgoing>Flow_Dispatching_To_Verifier</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_Verifier" name="Vérifier">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Dispatching_To_Verifier</bpmn:incoming>
      <bpmn:outgoing>Flow_Verifier_To_Valider</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_Paiement" name="Paiement">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Decision_To_Paiement</bpmn:incoming>
      <bpmn:outgoing>Flow_Paiement_To_Gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="Activity_Recevoir" name="Recevoir réclamation">
      <bpmn:incoming>Flow_Soumettre_To_Recevoir</bpmn:incoming>
      <bpmn:outgoing>Flow_Recevoir_To_Annoter</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="Activity_Notification" name="Notifier">
      <bpmn:incoming>Flow_Gateway_To_Notification</bpmn:incoming>
      <bpmn:outgoing>Flow_Notification_To_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Décision">
      <bpmn:incoming>Flow_Valider_To_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Decision_To_Paiement</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision_To_Refus</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_1sf18rz">
      <bpmn:incoming>Flow_Paiement_To_Gateway</bpmn:incoming>
      <bpmn:incoming>Flow_Refus_To_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_To_Notification</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Fin" name="FIN">
      <bpmn:incoming>Flow_Notification_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_To_Soumettre" sourceRef="StartEvent_Reclamation" targetRef="Activity_Soumettre" />
    <bpmn:sequenceFlow id="Flow_Soumettre_To_Recevoir" sourceRef="Activity_Soumettre" targetRef="Activity_Recevoir" />
    <bpmn:sequenceFlow id="Flow_Recevoir_To_Annoter" sourceRef="Activity_Recevoir" targetRef="Activity_Annoter" />
    <bpmn:sequenceFlow id="Flow_Annoter_To_Dispatching" sourceRef="Activity_Annoter" targetRef="Activity_Dispatching" />
    <bpmn:sequenceFlow id="Flow_Dispatching_To_Verifier" sourceRef="Activity_Dispatching" targetRef="Activity_Verifier" />
    <bpmn:sequenceFlow id="Flow_Verifier_To_Valider" sourceRef="Activity_Verifier" targetRef="Activity_Valider" />
    <bpmn:sequenceFlow id="Flow_Valider_To_Decision" sourceRef="Activity_Valider" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_Decision_To_Paiement" name="paiement" sourceRef="Gateway_Decision" targetRef="Activity_Paiement" />
    <bpmn:sequenceFlow id="Flow_Decision_To_Refus" name="refus" sourceRef="Gateway_Decision" targetRef="Activity_Refus" />
    <bpmn:sequenceFlow id="Flow_Paiement_To_Gateway" sourceRef="Activity_Paiement" targetRef="Gateway_1sf18rz" />
    <bpmn:sequenceFlow id="Flow_Refus_To_Gateway" sourceRef="Activity_Refus" targetRef="Gateway_1sf18rz" />
    <bpmn:sequenceFlow id="Flow_Gateway_To_Notification" sourceRef="Gateway_1sf18rz" targetRef="Activity_Notification" />
    <bpmn:sequenceFlow id="Flow_Notification_To_End" sourceRef="Activity_Notification" targetRef="EndEvent_Fin" />
    <bpmn:userTask id="Activity_Annoter" name="Annoter">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Recevoir_To_Annoter</bpmn:incoming>
      <bpmn:outgoing>Flow_Annoter_To_Dispatching</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_Refus" name="Refus">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Decision_To_Refus</bpmn:incoming>
      <bpmn:outgoing>Flow_Refus_To_Gateway</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
