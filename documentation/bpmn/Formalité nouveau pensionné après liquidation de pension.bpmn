<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_FormalitesNormal" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_FormalitesNormal">
    <bpmn:participant id="Participant_FormalitesNormal" name="Direction de la Pension Civile" processRef="Process_FormalitesNormal" />
    <bpmn:textAnnotation id="TextAnnotation_Commun">
      <bpmn:text>Pièces communes : Matricule fiscal, 2 photos couleur, Lettre fin de service, Fiche bancaire, CINU</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Haiti">
      <bpmn:text>HAÏTI : ajouter Carte de pension et 1 photo supplémentaire</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Etranger">
      <bpmn:text>ÉTRANGER : ajouter formulaire de désignation du mandataire signé et Pièce d'identité du mandataire</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Haiti" sourceRef="Flow_Gateway_To_Haiti" targetRef="TextAnnotation_Haiti" />
    <bpmn:association id="Association_Etranger" sourceRef="Flow_Gateway_To_Etranger" targetRef="TextAnnotation_Etranger" />
    <bpmn:association id="Association_Commun" sourceRef="Activity_Soumettre_Formalite" targetRef="TextAnnotation_Commun" />
  </bpmn:collaboration>
  <bpmn:process id="Process_FormalitesNormal" isExecutable="true">
    <bpmn:laneSet id="LaneSet_FormalitesNormal">
      <bpmn:lane id="Lane_Direction" name="Direction">
        <bpmn:flowNodeRef>Activity_Validation_Direction_Etranger</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ServiceFormalite" name="Service Formalité">
        <bpmn:flowNodeRef>Activity_Reception_Chef_Haiti</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Dispatching_Haiti</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Vignette_Haiti</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0dsioji</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Reception_Chef_Etranger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Dispatching_Etranger</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pensionne" name="Pensionné">
        <bpmn:flowNodeRef>StartEvent_Formalite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Soumettre_Formalite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Choix_Lieu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Formalite</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Formalite" name="Formalité à soumettre">
      <bpmn:outgoing>Flow_Start_To_Soumettre</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_Soumettre_Formalite" name="Soumettre formalité">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_Soumettre</bpmn:incoming>
      <bpmn:outgoing>Flow_Soumettre_To_Gateway_Choix</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Choix_Lieu" name="Lieu de résidence">
      <bpmn:incoming>Flow_Soumettre_To_Gateway_Choix</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_To_Haiti</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_To_Etranger</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_Reception_Chef_Haiti" name="Réception Chef de service">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_To_Haiti</bpmn:incoming>
      <bpmn:outgoing>Flow_Haiti_Reception_To_Dispatching</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_Dispatching_Haiti" name="Dispatching agents">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Haiti_Reception_To_Dispatching</bpmn:incoming>
      <bpmn:outgoing>Flow_Haiti_Dispatching_To_Vignette</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Formalite" name="FIN">
      <bpmn:incoming>Flow_1ar3ule</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_Vignette_Haiti" name="Vignette de formalité">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0hfq4zm</bpmn:incoming>
      <bpmn:outgoing>Flow_1ar3ule</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0dsioji">
      <bpmn:incoming>Flow_Haiti_Dispatching_To_Vignette</bpmn:incoming>
      <bpmn:incoming>Flow_Etranger_Validation_To_Vignette</bpmn:incoming>
      <bpmn:outgoing>Flow_0hfq4zm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_Reception_Chef_Etranger" name="Réception Chef de service">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_To_Etranger</bpmn:incoming>
      <bpmn:outgoing>Flow_Etranger_Reception_To_Dispatching</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_Dispatching_Etranger" name="Dispatching agents">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Etranger_Reception_To_Dispatching</bpmn:incoming>
      <bpmn:outgoing>Flow_Etranger_Dispatching_To_Validation</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Start_To_Soumettre" sourceRef="StartEvent_Formalite" targetRef="Activity_Soumettre_Formalite" />
    <bpmn:sequenceFlow id="Flow_Soumettre_To_Gateway_Choix" sourceRef="Activity_Soumettre_Formalite" targetRef="Gateway_Choix_Lieu" />
    <bpmn:sequenceFlow id="Flow_Gateway_To_Haiti" name="En Haïti" sourceRef="Gateway_Choix_Lieu" targetRef="Activity_Reception_Chef_Haiti">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${residence == "Haiti"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_To_Etranger" name="À l&#39;étranger" sourceRef="Gateway_Choix_Lieu" targetRef="Activity_Reception_Chef_Etranger">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${residence == "Etranger"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Haiti_Reception_To_Dispatching" sourceRef="Activity_Reception_Chef_Haiti" targetRef="Activity_Dispatching_Haiti" />
    <bpmn:sequenceFlow id="Flow_Haiti_Dispatching_To_Vignette" sourceRef="Activity_Dispatching_Haiti" targetRef="Gateway_0dsioji" />
    <bpmn:sequenceFlow id="Flow_1ar3ule" sourceRef="Activity_Vignette_Haiti" targetRef="EndEvent_Formalite" />
    <bpmn:sequenceFlow id="Flow_0hfq4zm" sourceRef="Gateway_0dsioji" targetRef="Activity_Vignette_Haiti" />
    <bpmn:sequenceFlow id="Flow_Etranger_Validation_To_Vignette" sourceRef="Activity_Validation_Direction_Etranger" targetRef="Gateway_0dsioji" />
    <bpmn:sequenceFlow id="Flow_Etranger_Dispatching_To_Validation" sourceRef="Activity_Dispatching_Etranger" targetRef="Activity_Validation_Direction_Etranger" />
    <bpmn:sequenceFlow id="Flow_Etranger_Reception_To_Dispatching" sourceRef="Activity_Reception_Chef_Etranger" targetRef="Activity_Dispatching_Etranger" />
    <bpmn:userTask id="Activity_Validation_Direction_Etranger" name="Validation Direction">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Etranger_Dispatching_To_Validation</bpmn:incoming>
      <bpmn:outgoing>Flow_Etranger_Validation_To_Vignette</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_FormalitesNormal">
    <bpmndi:BPMNPlane id="BPMNPlane_FormalitesNormal" bpmnElement="Collaboration_FormalitesNormal">
