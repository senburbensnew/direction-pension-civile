      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Dispatching_SLP_DroitPropre_di" bpmnElement="Activity_Dispatching_SLP_DroitPropre">
        <dc:Bounds x="1820" y="950" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- SLP deuxième ligne (suite) -->
      <bpmndi:BPMNShape id="Activity_Traitement_SLP_DroitPropre_di" bpmnElement="Activity_Traitement_SLP_DroitPropre">
        <dc:Bounds x="380" y="1040" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Transmission_Tresor_DroitPropre_di" bpmnElement="Activity_Transmission_Tresor_DroitPropre">
        <dc:Bounds x="560" y="1040" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Retour_Fiche_Tresor_DroitPropre_di" bpmnElement="Activity_Retour_Fiche_Tresor_DroitPropre">
        <dc:Bounds x="740" y="1040" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Liquidation_DroitPropre_di" bpmnElement="Activity_Liquidation_DroitPropre">
        <dc:Bounds x="920" y="1040" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Envoi_Avis_Ministre_DroitPropre_di" bpmnElement="Activity_Envoi_Avis_Ministre_DroitPropre">
        <dc:Bounds x="1100" y="1040" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Transmission_Palais_DroitPropre_di" bpmnElement="Activity_Transmission_Palais_DroitPropre">
        <dc:Bounds x="1280" y="1040" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Diffusion_Institutions_DroitPropre_di" bpmnElement="Activity_Diffusion_Institutions_DroitPropre">
        <dc:Bounds x="1460" y="1040" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Saisie_SYSPENS_DroitPropre_di" bpmnElement="Activity_Saisie_SYSPENS_DroitPropre">
        <dc:Bounds x="1640" y="1040" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Accueil_Identification_DroitPropre_di" bpmnElement="Activity_Accueil_Identification_DroitPropre">
        <dc:Bounds x="1820" y="1040" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Paiement_DroitPropre_di" bpmnElement="Activity_Paiement_DroitPropre">
        <dc:Bounds x="2000" y="1040" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Preparation_Payroll_DroitPropre_di" bpmnElement="Activity_Preparation_Payroll_DroitPropre">
        <dc:Bounds x="2000" y="950" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Notification et fin -->
      <bpmndi:BPMNShape id="Activity_Notification_Finale_di" bpmnElement="Activity_Notification_Finale">
        <dc:Bounds x="2000" y="570" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_DroitPropre_di" bpmnElement="EndEvent_DroitPropre">
        <dc:Bounds x="2180" y="592" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2185" y="635" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="TextAnnotation_DroitPropre_di" bpmnElement="TextAnnotation_DroitPropre">
        <dc:Bounds x="530" y="80" width="280" height="140" />
      </bpmndi:BPMNShape>

      <!-- ========== ARÊTES (FLÈCHES) ========== -->
      <bpmndi:BPMNEdge id="Flow_Start_To_Soumettre_DroitPropre_di" bpmnElement="Flow_Start_To_Soumettre_DroitPropre">
        <di:waypoint x="288" y="610" /><di:waypoint x="380" y="610" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Soumettre_To_Gateway_Voie_DroitPropre_di" bpmnElement="Flow_Soumettre_To_Gateway_Voie_DroitPropre">
        <di:waypoint x="480" y="610" /><di:waypoint x="560" y="610" />
      </bpmndi:BPMNEdge>

      <!-- Vers voie 1 -->
      <bpmndi:BPMNEdge id="Flow_Gateway_To_Secretariat_DPC_di" bpmnElement="Flow_Gateway_To_Secretariat_DPC">
        <di:waypoint x="585" y="635" /><di:waypoint x="585" y="670" /><di:waypoint x="430" y="670" />
      </bpmndi:BPMNEdge>
      <!-- Vers voie 2 -->
      <bpmndi:BPMNEdge id="Flow_Gateway_To_Courrier_MEF_EnService_di" bpmnElement="Flow_Gateway_To_Courrier_MEF_EnService">
        <di:waypoint x="585" y="635" /><di:waypoint x="585" y="770" /><di:waypoint x="430" y="770" />
      </bpmndi:BPMNEdge>
      <!-- Vers voie 3 -->
      <bpmndi:BPMNEdge id="Flow_Gateway_To_Courrier_MEF_PasEnService_di" bpmnElement="Flow_Gateway_To_Courrier_MEF_PasEnService">
        <di:waypoint x="585" y="635" /><di:waypoint x="585" y="870" /><di:waypoint x="430" y="870" />
      </bpmndi:BPMNEdge>

      <!-- Voie 1 -->
      <bpmndi:BPMNEdge id="Flow_Secretariat_To_VerifSec_DroitPropre_di" bpmnElement="Flow_Secretariat_To_VerifSec_DroitPropre">
        <di:waypoint x="480" y="710" /><di:waypoint x="560" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_VerifSec_To_Accuse_DroitPropre_di" bpmnElement="Flow_VerifSec_To_Accuse_DroitPropre">
        <di:waypoint x="660" y="710" /><di:waypoint x="740" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Accuse_To_Fusion_DroitPropre_di" bpmnElement="Flow_Accuse_To_Fusion_DroitPropre">
        <di:waypoint x="840" y="710" /><di:waypoint x="840" y="610" /><di:waypoint x="1100" y="610" />
      </bpmndi:BPMNEdge>

      <!-- Voie 2 et 3 (communes) -->
      <bpmndi:BPMNEdge id="Flow_Courrier_To_VerifCour_DroitPropre_di" bpmnElement="Flow_Courrier_To_VerifCour_DroitPropre">
        <di:waypoint x="480" y="810" /><di:waypoint x="560" y="810" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CourrierPasEnService_To_VerifCour_DroitPropre_di" bpmnElement="Flow_CourrierPasEnService_To_VerifCour_DroitPropre">
        <di:waypoint x="480" y="910" /><di:waypoint x="480" y="810" /><di:waypoint x="560" y="810" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_VerifCour_To_Numero_DroitPropre_di" bpmnElement="Flow_VerifCour_To_Numero_DroitPropre">
        <di:waypoint x="660" y="810" /><di:waypoint x="740" y="810" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Numero_To_Transfert_DroitPropre_di" bpmnElement="Flow_Numero_To_Transfert_DroitPropre">
        <di:waypoint x="840" y="810" /><di:waypoint x="920" y="810" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Transfert_To_Fusion_DroitPropre_di" bpmnElement="Flow_Transfert_To_Fusion_DroitPropre">
        <di:waypoint x="1020" y="810" /><di:waypoint x="1020" y="610" /><di:waypoint x="1100" y="610" />
      </bpmndi:BPMNEdge>

      <!-- Fusion → Annotation Directeur -->
      <bpmndi:BPMNEdge id="Flow_Fusion_To_AnnotationDirecteur_DroitPropre_di" bpmnElement="Flow_Fusion_To_AnnotationDirecteur_DroitPropre">
        <di:waypoint x="1150" y="610" /><di:waypoint x="1150" y="870" /><di:waypoint x="1280" y="910" />
      </bpmndi:BPMNEdge>

      <!-- Annotation Directeur → SLP -->
      <bpmndi:BPMNEdge id="Flow_AnnotationDirecteur_To_ReceptionSLP_DroitPropre_di" bpmnElement="Flow_AnnotationDirecteur_To_ReceptionSLP_DroitPropre">
        <di:waypoint x="1380" y="910" /><di:waypoint x="1460" y="990" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReceptionSLP_To_AnnotationChef_SLP_DroitPropre_di" bpmnElement="Flow_ReceptionSLP_To_AnnotationChef_SLP_DroitPropre">
        <di:waypoint x="1560" y="990" /><di:waypoint x="1640" y="990" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AnnotationChef_To_Dispatching_SLP_DroitPropre_di" bpmnElement="Flow_AnnotationChef_To_Dispatching_SLP_DroitPropre">
        <di:waypoint x="1740" y="990" /><di:waypoint x="1820" y="990" />
      </bpmndi:BPMNEdge>

      <!-- SLP : descente vers la deuxième ligne -->
      <bpmndi:BPMNEdge id="Flow_Dispatching_To_Traitement_SLP_DroitPropre_di" bpmnElement="Flow_Dispatching_To_Traitement_SLP_DroitPropre">
        <di:waypoint x="1870" y="1030" /><di:waypoint x="1870" y="1040" /><di:waypoint x="480" y="1040" />
      </bpmndi:BPMNEdge>

      <!-- Deuxième ligne SLP -->
      <bpmndi:BPMNEdge id="Flow_TraitementSLP_To_Transmission_Tresor_DroitPropre_di" bpmnElement="Flow_TraitementSLP_To_Transmission_Tresor_DroitPropre">
        <di:waypoint x="480" y="1080" /><di:waypoint x="560" y="1080" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TransmissionTresor_To_RetourFiche_DroitPropre_di" bpmnElement="Flow_TransmissionTresor_To_RetourFiche_DroitPropre">
