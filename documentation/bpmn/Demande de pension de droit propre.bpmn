      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_EnvoiAvis_To_TransmissionPalais_DroitPropre_di" bpmnElement="Flow_EnvoiAvis_To_TransmissionPalais_DroitPropre">
        <di:waypoint x="1200" y="1080" /><di:waypoint x="1280" y="1080" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TransmissionPalais_To_Diffusion_DroitPropre_di" bpmnElement="Flow_TransmissionPalais_To_Diffusion_DroitPropre">
        <di:waypoint x="1380" y="1080" /><di:waypoint x="1460" y="1080" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Diffusion_To_SaisieSYSPENS_DroitPropre_di" bpmnElement="Flow_Diffusion_To_SaisieSYSPENS_DroitPropre">
        <di:waypoint x="1560" y="1080" /><di:waypoint x="1640" y="1080" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SaisieSYSPENS_To_Accueil_DroitPropre_di" bpmnElement="Flow_SaisieSYSPENS_To_Accueil_DroitPropre">
        <di:waypoint x="1740" y="1080" /><di:waypoint x="1820" y="1080" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Accueil_To_Paiement_DroitPropre_di" bpmnElement="Flow_Accueil_To_Paiement_DroitPropre">
        <di:waypoint x="1920" y="1080" /><di:waypoint x="2000" y="1080" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Paiement_To_Payroll_DroitPropre_di" bpmnElement="Flow_Paiement_To_Payroll_DroitPropre">
        <di:waypoint x="2050" y="1040" /><di:waypoint x="2050" y="990" /><di:waypoint x="2000" y="990" />
      </bpmndi:BPMNEdge>

      <!-- Payroll → Notification -->
      <bpmndi:BPMNEdge id="Flow_Payroll_To_Notification_Finale_DroitPropre_di" bpmnElement="Flow_Payroll_To_Notification_Finale_DroitPropre">
        <di:waypoint x="2050" y="950" /><di:waypoint x="2050" y="610" /><di:waypoint x="2000" y="610" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Notification_To_End_DroitPropre_di" bpmnElement="Flow_Notification_To_End_DroitPropre">
        <di:waypoint x="2100" y="610" /><di:waypoint x="2180" y="610" />
      </bpmndi:BPMNEdge>

      <!-- Association -->
      <bpmndi:BPMNEdge id="Association_DroitPropre_di" bpmnElement="Association_DroitPropre">
        <di:waypoint x="430" y="570" /><di:waypoint x="530" y="150" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
