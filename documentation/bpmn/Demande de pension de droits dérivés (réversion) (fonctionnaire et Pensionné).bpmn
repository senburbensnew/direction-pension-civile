      <bpmndi:BPMNShape id="Activity_Accuse_Reception_Reversion_di" bpmnElement="Activity_Accuse_Reception_Reversion">
        <dc:Bounds x="1120" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Numero_Reception_Reversion_di" bpmnElement="Activity_Numero_Reception_Reversion">
        <dc:Bounds x="1120" y="490" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Transfert_DPC_Reversion_di" bpmnElement="Activity_Transfert_DPC_Reversion">
        <dc:Bounds x="1300" y="490" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Fusion_Voies_Reversion_di" bpmnElement="Gateway_Fusion_Voies_Reversion" isMarkerVisible="true">
        <dc:Bounds x="1480" y="305" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Annotation_Directeur_Reversion_di" bpmnElement="Activity_Annotation_Directeur_Reversion">
        <dc:Bounds x="1660" y="590" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Traitement_SLP_Reversion_di" bpmnElement="Activity_Traitement_SLP_Reversion">
        <dc:Bounds x="1840" y="670" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Reversion_di" bpmnElement="EndEvent_Reversion">
        <dc:Bounds x="2020" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2025" y="355" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Verification_Secretariat_Reversion_di" bpmnElement="Activity_Verification_Secretariat_Reversion">
        <dc:Bounds x="945" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Depot_Secretariat_Reversion_di" bpmnElement="Activity_Depot_Secretariat_Reversion">
        <dc:Bounds x="750" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Verification_Courrier_Reversion_di" bpmnElement="Activity_Verification_Courrier_Reversion">
        <dc:Bounds x="750" y="490" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Depot_Courrier_Reversion_di" bpmnElement="Activity_Depot_Courrier_Reversion">
        <dc:Bounds x="590" y="490" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_To_Soumettre_Reversion_di" bpmnElement="Flow_Start_To_Soumettre_Reversion">
        <di:waypoint x="288" y="330" />
        <di:waypoint x="380" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Soumettre_To_Gateway_Voie_Reversion_di" bpmnElement="Flow_Soumettre_To_Gateway_Voie_Reversion">
        <di:waypoint x="480" y="330" />
        <di:waypoint x="615" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_To_Secretariat_Reversion_di" bpmnElement="Flow_Gateway_To_Secretariat_Reversion">
        <di:waypoint x="665" y="330" />
        <di:waypoint x="800" y="330" />
        <di:waypoint x="800" y="390" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="704" y="286" width="71" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_To_Courrier_Reversion_di" bpmnElement="Flow_Gateway_To_Courrier_Reversion">
        <di:waypoint x="640" y="355" />
        <di:waypoint x="640" y="490" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="613" y="413" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Secretariat_To_VerifSec_Reversion_di" bpmnElement="Flow_Secretariat_To_VerifSec_Reversion">
        <di:waypoint x="850" y="430" />
        <di:waypoint x="945" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_VerifSec_To_Accuse_Reversion_di" bpmnElement="Flow_VerifSec_To_Accuse_Reversion">
        <di:waypoint x="1045" y="430" />
        <di:waypoint x="1120" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Accuse_To_Fusion_Reversion_di" bpmnElement="Flow_Accuse_To_Fusion_Reversion">
        <di:waypoint x="1220" y="430" />
        <di:waypoint x="1330" y="430" />
        <di:waypoint x="1330" y="330" />
        <di:waypoint x="1480" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Courrier_To_VerifCour_Reversion_di" bpmnElement="Flow_Courrier_To_VerifCour_Reversion">
        <di:waypoint x="690" y="530" />
        <di:waypoint x="750" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_VerifCour_To_Numero_Reversion_di" bpmnElement="Flow_VerifCour_To_Numero_Reversion">
        <di:waypoint x="850" y="530" />
        <di:waypoint x="1120" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Numero_To_Transfert_Reversion_di" bpmnElement="Flow_Numero_To_Transfert_Reversion">
        <di:waypoint x="1220" y="530" />
        <di:waypoint x="1300" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Transfert_To_Fusion_Reversion_di" bpmnElement="Flow_Transfert_To_Fusion_Reversion">
        <di:waypoint x="1400" y="530" />
        <di:waypoint x="1505" y="530" />
        <di:waypoint x="1505" y="355" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fusion_To_AnnotationDirecteur_Reversion_di" bpmnElement="Flow_Fusion_To_AnnotationDirecteur_Reversion">
        <di:waypoint x="1530" y="330" />
        <di:waypoint x="1590" y="330" />
        <di:waypoint x="1590" y="630" />
        <di:waypoint x="1660" y="630" />
