        <dc:Bounds x="190" y="480" width="2150" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Secretariat_DPC_di" bpmnElement="Lane_Secretariat_DPC" isHorizontal="true">
        <dc:Bounds x="190" y="380" width="2150" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Usager_di" bpmnElement="Lane_Usager" isHorizontal="true">
        <dc:Bounds x="190" y="280" width="2150" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Reversion_di" bpmnElement="StartEvent_Reversion">
        <dc:Bounds x="252" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="240" y="355" width="63" height="27" />
