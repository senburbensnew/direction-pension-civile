<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_TransfertCheque"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.50.1"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_TransfertCheque">
    <bpmn:participant id="Participant_TransfertCheque" name="Direction de la Pension Civile" processRef="Process_TransfertCheque" />
    <bpmn:textAnnotation id="TextAnnotation_TransfertCheque">
      <bpmn:text>Pièces : Carte de pension, Matricule fiscal, Formulaire de demande de transfert de chèque</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_TransfertCheque" sourceRef="Activity_Soumettre_Transfert" targetRef="TextAnnotation_TransfertCheque" />
  </bpmn:collaboration>

  <bpmn:process id="Process_TransfertCheque" isExecutable="true">
    <bpmn:laneSet id="LaneSet_TransfertCheque">
      <bpmn:lane id="Lane_Pensionne" name="Pensionné">
        <bpmn:flowNodeRef>StartEvent_Transfert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Soumettre_Transfert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Notification_Transfert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Transfert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Secretariat" name="Secrétariat">
        <bpmn:flowNodeRef>Activity_Reception_Secretariat</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Direction" name="Direction">
        <bpmn:flowNodeRef>Activity_Annotation_Direction</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ServiceCompta" name="Service Comptabilité">
        <bpmn:flowNodeRef>Activity_Traitement_Compta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SecretariatCompta" name="Secrétariat Comptabilité">
        <bpmn:flowNodeRef>Activity_Reception_Compta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ChefService" name="Chef de service">
        <bpmn:flowNodeRef>Activity_Annotation_Chef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Dispatching</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Agent">
        <bpmn:flowNodeRef>Activity_Verification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Validation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Transfert</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start -->
    <bpmn:startEvent id="StartEvent_Transfert" name="Soumission">
      <bpmn:outgoing>Flow_Start_To_Soumettre</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tâches -->
    <bpmn:userTask id="Activity_Soumettre_Transfert" name="Soumettre demande">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_Soumettre</bpmn:incoming>
      <bpmn:outgoing>Flow_Soumettre_To_ReceptionSec</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:receiveTask id="Activity_Reception_Secretariat" name="Réception Secrétariat">
      <bpmn:incoming>Flow_Soumettre_To_ReceptionSec</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceptionSec_To_AnnotationDir</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:userTask id="Activity_Annotation_Direction" name="Annotation Direction">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_ReceptionSec_To_AnnotationDir</bpmn:incoming>
      <bpmn:outgoing>Flow_AnnotationDir_To_TraitementCompta</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Activity_Traitement_Compta" name="Traitement Service Comptabilité">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_AnnotationDir_To_TraitementCompta</bpmn:incoming>
      <bpmn:outgoing>Flow_TraitementCompta_To_ReceptionCompta</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:receiveTask id="Activity_Reception_Compta" name="Réception Secrétariat Comptabilité">
      <bpmn:incoming>Flow_TraitementCompta_To_ReceptionCompta</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceptionCompta_To_AnnotationChef</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:userTask id="Activity_Annotation_Chef" name="Annotation Chef de service">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_ReceptionCompta_To_AnnotationChef</bpmn:incoming>
      <bpmn:outgoing>Flow_AnnotationChef_To_Dispatching</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Activity_Dispatching" name="Dispatching">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_AnnotationChef_To_Dispatching</bpmn:incoming>
      <bpmn:outgoing>Flow_Dispatching_To_Verification</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Activity_Verification" name="Vérification dossier">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Dispatching_To_Verification</bpmn:incoming>
      <bpmn:outgoing>Flow_Verification_To_Validation</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Activity_Validation" name="Validation requête">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Verification_To_Validation</bpmn:incoming>
      <bpmn:outgoing>Flow_Validation_To_Transfert</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Activity_Transfert" name="Transfert des chèques">
      <bpmn:incoming>Flow_Validation_To_Transfert</bpmn:incoming>
      <bpmn:outgoing>Flow_Transfert_To_Notification</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Activity_Notification_Transfert" name="Notifier pensionné">
      <bpmn:incoming>Flow_Transfert_To_Notification</bpmn:incoming>
      <bpmn:outgoing>Flow_Notification_To_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Transfert" name="FIN">
      <bpmn:incoming>Flow_Notification_To_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_Start_To_Soumettre" sourceRef="StartEvent_Transfert" targetRef="Activity_Soumettre_Transfert" />
    <bpmn:sequenceFlow id="Flow_Soumettre_To_ReceptionSec" sourceRef="Activity_Soumettre_Transfert" targetRef="Activity_Reception_Secretariat" />
    <bpmn:sequenceFlow id="Flow_ReceptionSec_To_AnnotationDir" sourceRef="Activity_Reception_Secretariat" targetRef="Activity_Annotation_Direction" />
    <bpmn:sequenceFlow id="Flow_AnnotationDir_To_TraitementCompta" sourceRef="Activity_Annotation_Direction" targetRef="Activity_Traitement_Compta" />
    <bpmn:sequenceFlow id="Flow_TraitementCompta_To_ReceptionCompta" sourceRef="Activity_Traitement_Compta" targetRef="Activity_Reception_Compta" />
    <bpmn:sequenceFlow id="Flow_ReceptionCompta_To_AnnotationChef" sourceRef="Activity_Reception_Compta" targetRef="Activity_Annotation_Chef" />
    <bpmn:sequenceFlow id="Flow_AnnotationChef_To_Dispatching" sourceRef="Activity_Annotation_Chef" targetRef="Activity_Dispatching" />
    <bpmn:sequenceFlow id="Flow_Dispatching_To_Verification" sourceRef="Activity_Dispatching" targetRef="Activity_Verification" />
    <bpmn:sequenceFlow id="Flow_Verification_To_Validation" sourceRef="Activity_Verification" targetRef="Activity_Validation" />
    <bpmn:sequenceFlow id="Flow_Validation_To_Transfert" sourceRef="Activity_Validation" targetRef="Activity_Transfert" />
    <bpmn:sequenceFlow id="Flow_Transfert_To_Notification" sourceRef="Activity_Transfert" targetRef="Activity_Notification_Transfert" />
    <bpmn:sequenceFlow id="Flow_Notification_To_End" sourceRef="Activity_Notification_Transfert" targetRef="EndEvent_Transfert" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_TransfertCheque">
    <bpmndi:BPMNPlane id="BPMNPlane_TransfertCheque" bpmnElement="Collaboration_TransfertCheque">
      <!-- Pool -->
      <bpmndi:BPMNShape id="Participant_TransfertCheque_di" bpmnElement="Participant_TransfertCheque" isHorizontal="true">
        <dc:Bounds x="160" y="560" width="1400" height="700" />
      </bpmndi:BPMNShape>
      <!-- Lanes -->
      <bpmndi:BPMNShape id="Lane_Pensionne_di" bpmnElement="Lane_Pensionne" isHorizontal="true">
        <dc:Bounds x="190" y="560" width="1370" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Secretariat_di" bpmnElement="Lane_Secretariat" isHorizontal="true">
        <dc:Bounds x="190" y="660" width="1370" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Direction_di" bpmnElement="Lane_Direction" isHorizontal="true">
        <dc:Bounds x="190" y="760" width="1370" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ServiceCompta_di" bpmnElement="Lane_ServiceCompta" isHorizontal="true">
        <dc:Bounds x="190" y="860" width="1370" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SecretariatCompta_di" bpmnElement="Lane_SecretariatCompta" isHorizontal="true">
        <dc:Bounds x="190" y="960" width="1370" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ChefService_di" bpmnElement="Lane_ChefService" isHorizontal="true">
        <dc:Bounds x="190" y="1060" width="1370" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Agent_di" bpmnElement="Lane_Agent" isHorizontal="true">
        <dc:Bounds x="190" y="1160" width="1370" height="100" />
      </bpmndi:BPMNShape>

      <!-- Formes -->
      <bpmndi:BPMNShape id="StartEvent_Transfert_di" bpmnElement="StartEvent_Transfert">
        <dc:Bounds x="252" y="592" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="235" y="635" width="73" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Soumettre_Transfert_di" bpmnElement="Activity_Soumettre_Transfert">
        <dc:Bounds x="380" y="570" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Reception_Secretariat_di" bpmnElement="Activity_Reception_Secretariat">
        <dc:Bounds x="380" y="670" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Annotation_Direction_di" bpmnElement="Activity_Annotation_Direction">
        <dc:Bounds x="380" y="770" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Traitement_Compta_di" bpmnElement="Activity_Traitement_Compta">
        <dc:Bounds x="380" y="870" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Reception_Compta_di" bpmnElement="Activity_Reception_Compta">
        <dc:Bounds x="380" y="970" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Annotation_Chef_di" bpmnElement="Activity_Annotation_Chef">
        <dc:Bounds x="380" y="1070" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Dispatching_di" bpmnElement="Activity_Dispatching">
        <dc:Bounds x="550" y="1070" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Verification_di" bpmnElement="Activity_Verification">
        <dc:Bounds x="550" y="1170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Validation_di" bpmnElement="Activity_Validation">
        <dc:Bounds x="720" y="1170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Transfert_di" bpmnElement="Activity_Transfert">
        <dc:Bounds x="890" y="1170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Notification_Transfert_di" bpmnElement="Activity_Notification_Transfert">
        <dc:Bounds x="1060" y="570" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Transfert_di" bpmnElement="EndEvent_Transfert">
        <dc:Bounds x="1250" y="592" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1255" y="635" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_TransfertCheque_di" bpmnElement="TextAnnotation_TransfertCheque">
        <dc:Bounds x="530" y="80" width="200" height="100" />
      </bpmndi:BPMNShape>

      <!-- Arêtes -->
      <bpmndi:BPMNEdge id="Flow_Start_To_Soumettre_di" bpmnElement="Flow_Start_To_Soumettre">
        <di:waypoint x="288" y="610" />
        <di:waypoint x="380" y="610" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Soumettre_To_ReceptionSec_di" bpmnElement="Flow_Soumettre_To_ReceptionSec">
        <di:waypoint x="430" y="650" />
        <di:waypoint x="430" y="670" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReceptionSec_To_AnnotationDir_di" bpmnElement="Flow_ReceptionSec_To_AnnotationDir">
        <di:waypoint x="430" y="750" />
        <di:waypoint x="430" y="770" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AnnotationDir_To_TraitementCompta_di" bpmnElement="Flow_AnnotationDir_To_TraitementCompta">
        <di:waypoint x="430" y="850" />
        <di:waypoint x="430" y="870" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TraitementCompta_To_ReceptionCompta_di" bpmnElement="Flow_TraitementCompta_To_ReceptionCompta">
        <di:waypoint x="430" y="950" />
        <di:waypoint x="430" y="970" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReceptionCompta_To_AnnotationChef_di" bpmnElement="Flow_ReceptionCompta_To_AnnotationChef">
        <di:waypoint x="430" y="1050" />
        <di:waypoint x="430" y="1070" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AnnotationChef_To_Dispatching_di" bpmnElement="Flow_AnnotationChef_To_Dispatching">
        <di:waypoint x="480" y="1110" />
        <di:waypoint x="550" y="1110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Dispatching_To_Verification_di" bpmnElement="Flow_Dispatching_To_Verification">
        <di:waypoint x="600" y="1150" />
        <di:waypoint x="600" y="1170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Verification_To_Validation_di" bpmnElement="Flow_Verification_To_Validation">
        <di:waypoint x="650" y="1210" />
        <di:waypoint x="720" y="1210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Validation_To_Transfert_di" bpmnElement="Flow_Validation_To_Transfert">
        <di:waypoint x="820" y="1210" />
        <di:waypoint x="890" y="1210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Transfert_To_Notification_di" bpmnElement="Flow_Transfert_To_Notification">
        <di:waypoint x="940" y="1170" />
        <di:waypoint x="940" y="610" />
        <di:waypoint x="1060" y="610" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Notification_To_End_di" bpmnElement="Flow_Notification_To_End">
        <di:waypoint x="1160" y="610" />
        <di:waypoint x="1250" y="610" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_TransfertCheque_di" bpmnElement="Association_TransfertCheque">
        <di:waypoint x="430" y="570" />
        <di:waypoint x="530" y="130" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>