<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_Reactivation"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.50.1"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_Reactivation">
    <bpmn:participant id="Participant_Reactivation" name="Direction de la Pension Civile" processRef="Process_Reactivation" />
    <bpmn:textAnnotation id="TextAnnotation_Reactivation">
      <bpmn:text>Pièces : Carte de pension, Matricule fiscal, CINU, Copie du contrat, Dernier chèque retiré, Formulaire de demande de réactivation</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Reactivation" sourceRef="Activity_Soumettre_Reactivation" targetRef="TextAnnotation_Reactivation" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Reactivation" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Reactivation">
      <bpmn:lane id="Lane_Pensionne" name="Pensionné">
        <bpmn:flowNodeRef>StartEvent_Reactivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Soumettre_Reactivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Notification_Reactivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Reactivation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Secretariat" name="Secrétariat">
        <bpmn:flowNodeRef>Activity_Reception_Secretariat_Reactivation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Direction" name="Direction">
        <bpmn:flowNodeRef>Activity_Annotation_Direction_Reactivation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SecretariatCompta" name="Secrétariat Comptabilité">
        <bpmn:flowNodeRef>Activity_Reception_Compta_Reactivation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ChefService" name="Chef de service">
        <bpmn:flowNodeRef>Activity_Annotation_Chef_Reactivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Dispatching_Reactivation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Agent">
        <bpmn:flowNodeRef>Activity_Traitement_Reactivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Pension_Reactivee_Reactivation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Reactivation" name="Soumission">
      <bpmn:outgoing>Flow_Start_To_Soumettre_Reactivation</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Soumission par le pensionné -->
    <bpmn:userTask id="Activity_Soumettre_Reactivation" name="Soumettre notification">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_Soumettre_Reactivation</bpmn:incoming>
      <bpmn:outgoing>Flow_Soumettre_To_ReceptionSec_Reactivation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 1. Réception Secrétariat -->
    <bpmn:receiveTask id="Activity_Reception_Secretariat_Reactivation" name="Réception Secrétariat">
      <bpmn:incoming>Flow_Soumettre_To_ReceptionSec_Reactivation</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceptionSec_To_AnnotationDir_Reactivation</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- 2. Annotation Direction -->
    <bpmn:userTask id="Activity_Annotation_Direction_Reactivation" name="Annotation Direction">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_ReceptionSec_To_AnnotationDir_Reactivation</bpmn:incoming>
      <bpmn:outgoing>Flow_AnnotationDir_To_ReceptionCompta_Reactivation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 3. Réception Secrétariat Comptabilité -->
    <bpmn:receiveTask id="Activity_Reception_Compta_Reactivation" name="Réception Secrétariat Comptabilité">
      <bpmn:incoming>Flow_AnnotationDir_To_ReceptionCompta_Reactivation</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceptionCompta_To_AnnotationChef_Reactivation</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- 4. Annotation Chef de service -->
    <bpmn:userTask id="Activity_Annotation_Chef_Reactivation" name="Annotation Chef de service">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_ReceptionCompta_To_AnnotationChef_Reactivation</bpmn:incoming>
      <bpmn:outgoing>Flow_AnnotationChef_To_Dispatching_Reactivation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 5. Dispatching -->
    <bpmn:userTask id="Activity_Dispatching_Reactivation" name="Dispatching">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_AnnotationChef_To_Dispatching_Reactivation</bpmn:incoming>
      <bpmn:outgoing>Flow_Dispatching_To_Traitement_Reactivation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 6. Traitement du dossier -->
    <bpmn:userTask id="Activity_Traitement_Reactivation" name="Traitement du dossier">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Dispatching_To_Traitement_Reactivation</bpmn:incoming>
      <bpmn:outgoing>Flow_Traitement_To_PensionReactivee_Reactivation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 7. Pension réactivée -->
    <bpmn:serviceTask id="Activity_Pension_Reactivee_Reactivation" name="Pension réactivée">
      <bpmn:incoming>Flow_Traitement_To_PensionReactivee_Reactivation</bpmn:incoming>
      <bpmn:outgoing>Flow_PensionReactivee_To_Notification_Reactivation</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 8. Notification au pensionné -->
    <bpmn:serviceTask id="Activity_Notification_Reactivation" name="Notifier pensionné">
      <bpmn:incoming>Flow_PensionReactivee_To_Notification_Reactivation</bpmn:incoming>
      <bpmn:outgoing>Flow_Notification_To_End_Reactivation</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 9. Fin -->
    <bpmn:endEvent id="EndEvent_Reactivation" name="FIN">
      <bpmn:incoming>Flow_Notification_To_End_Reactivation</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_Start_To_Soumettre_Reactivation" sourceRef="StartEvent_Reactivation" targetRef="Activity_Soumettre_Reactivation" />
    <bpmn:sequenceFlow id="Flow_Soumettre_To_ReceptionSec_Reactivation" sourceRef="Activity_Soumettre_Reactivation" targetRef="Activity_Reception_Secretariat_Reactivation" />
    <bpmn:sequenceFlow id="Flow_ReceptionSec_To_AnnotationDir_Reactivation" sourceRef="Activity_Reception_Secretariat_Reactivation" targetRef="Activity_Annotation_Direction_Reactivation" />
    <bpmn:sequenceFlow id="Flow_AnnotationDir_To_ReceptionCompta_Reactivation" sourceRef="Activity_Annotation_Direction_Reactivation" targetRef="Activity_Reception_Compta_Reactivation" />
    <bpmn:sequenceFlow id="Flow_ReceptionCompta_To_AnnotationChef_Reactivation" sourceRef="Activity_Reception_Compta_Reactivation" targetRef="Activity_Annotation_Chef_Reactivation" />
    <bpmn:sequenceFlow id="Flow_AnnotationChef_To_Dispatching_Reactivation" sourceRef="Activity_Annotation_Chef_Reactivation" targetRef="Activity_Dispatching_Reactivation" />
    <bpmn:sequenceFlow id="Flow_Dispatching_To_Traitement_Reactivation" sourceRef="Activity_Dispatching_Reactivation" targetRef="Activity_Traitement_Reactivation" />
    <bpmn:sequenceFlow id="Flow_Traitement_To_PensionReactivee_Reactivation" sourceRef="Activity_Traitement_Reactivation" targetRef="Activity_Pension_Reactivee_Reactivation" />
    <bpmn:sequenceFlow id="Flow_PensionReactivee_To_Notification_Reactivation" sourceRef="Activity_Pension_Reactivee_Reactivation" targetRef="Activity_Notification_Reactivation" />
    <bpmn:sequenceFlow id="Flow_Notification_To_End_Reactivation" sourceRef="Activity_Notification_Reactivation" targetRef="EndEvent_Reactivation" />

  </bpmn:process>

  <!-- BPMN Diagram -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_Reactivation">
    <bpmndi:BPMNPlane id="BPMNPlane_Reactivation" bpmnElement="Collaboration_Reactivation">
      <!-- Pool -->
      <bpmndi:BPMNShape id="Participant_Reactivation_di" bpmnElement="Participant_Reactivation" isHorizontal="true">
        <dc:Bounds x="160" y="560" width="1400" height="700" />
      </bpmndi:BPMNShape>

      <!-- Lanes -->
      <bpmndi:BPMNShape id="Lane_Pensionne_di_Reactivation" bpmnElement="Lane_Pensionne" isHorizontal="true">
        <dc:Bounds x="190" y="560" width="1370" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Secretariat_di_Reactivation" bpmnElement="Lane_Secretariat" isHorizontal="true">
        <dc:Bounds x="190" y="660" width="1370" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Direction_di_Reactivation" bpmnElement="Lane_Direction" isHorizontal="true">
        <dc:Bounds x="190" y="760" width="1370" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SecretariatCompta_di_Reactivation" bpmnElement="Lane_SecretariatCompta" isHorizontal="true">
        <dc:Bounds x="190" y="860" width="1370" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ChefService_di_Reactivation" bpmnElement="Lane_ChefService" isHorizontal="true">
        <dc:Bounds x="190" y="960" width="1370" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Agent_di_Reactivation" bpmnElement="Lane_Agent" isHorizontal="true">
        <dc:Bounds x="190" y="1060" width="1370" height="100" />
      </bpmndi:BPMNShape>

      <!-- Formes -->
      <bpmndi:BPMNShape id="StartEvent_Reactivation_di" bpmnElement="StartEvent_Reactivation">
        <dc:Bounds x="252" y="592" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="235" y="635" width="73" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_Soumettre_Reactivation_di" bpmnElement="Activity_Soumettre_Reactivation">
        <dc:Bounds x="380" y="570" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_Reception_Secretariat_Reactivation_di" bpmnElement="Activity_Reception_Secretariat_Reactivation">
        <dc:Bounds x="380" y="670" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_Annotation_Direction_Reactivation_di" bpmnElement="Activity_Annotation_Direction_Reactivation">
        <dc:Bounds x="380" y="770" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_Reception_Compta_Reactivation_di" bpmnElement="Activity_Reception_Compta_Reactivation">
        <dc:Bounds x="380" y="870" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_Annotation_Chef_Reactivation_di" bpmnElement="Activity_Annotation_Chef_Reactivation">
        <dc:Bounds x="380" y="970" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_Dispatching_Reactivation_di" bpmnElement="Activity_Dispatching_Reactivation">
        <dc:Bounds x="560" y="970" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_Traitement_Reactivation_di" bpmnElement="Activity_Traitement_Reactivation">
        <dc:Bounds x="560" y="1070" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_Pension_Reactivee_Reactivation_di" bpmnElement="Activity_Pension_Reactivee_Reactivation">
        <dc:Bounds x="740" y="1070" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_Notification_Reactivation_di" bpmnElement="Activity_Notification_Reactivation">
        <dc:Bounds x="920" y="570" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Reactivation_di" bpmnElement="EndEvent_Reactivation">
        <dc:Bounds x="1100" y="592" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1105" y="635" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="TextAnnotation_Reactivation_di" bpmnElement="TextAnnotation_Reactivation">
        <dc:Bounds x="530" y="80" width="220" height="120" />
      </bpmndi:BPMNShape>

      <!-- Arêtes -->
      <bpmndi:BPMNEdge id="Flow_Start_To_Soumettre_Reactivation_di" bpmnElement="Flow_Start_To_Soumettre_Reactivation">
        <di:waypoint x="288" y="610" />
        <di:waypoint x="380" y="610" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Soumettre_To_ReceptionSec_Reactivation_di" bpmnElement="Flow_Soumettre_To_ReceptionSec_Reactivation">
        <di:waypoint x="430" y="650" />
        <di:waypoint x="430" y="670" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ReceptionSec_To_AnnotationDir_Reactivation_di" bpmnElement="Flow_ReceptionSec_To_AnnotationDir_Reactivation">
        <di:waypoint x="430" y="750" />
        <di:waypoint x="430" y="770" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_AnnotationDir_To_ReceptionCompta_Reactivation_di" bpmnElement="Flow_AnnotationDir_To_ReceptionCompta_Reactivation">
        <di:waypoint x="430" y="850" />
        <di:waypoint x="430" y="870" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ReceptionCompta_To_AnnotationChef_Reactivation_di" bpmnElement="Flow_ReceptionCompta_To_AnnotationChef_Reactivation">
        <di:waypoint x="430" y="950" />
        <di:waypoint x="430" y="970" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_AnnotationChef_To_Dispatching_Reactivation_di" bpmnElement="Flow_AnnotationChef_To_Dispatching_Reactivation">
        <di:waypoint x="480" y="1010" />
        <di:waypoint x="560" y="1010" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Dispatching_To_Traitement_Reactivation_di" bpmnElement="Flow_Dispatching_To_Traitement_Reactivation">
        <di:waypoint x="610" y="1050" />
        <di:waypoint x="610" y="1070" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Traitement_To_PensionReactivee_Reactivation_di" bpmnElement="Flow_Traitement_To_PensionReactivee_Reactivation">
        <di:waypoint x="660" y="1110" />
        <di:waypoint x="740" y="1110" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_PensionReactivee_To_Notification_Reactivation_di" bpmnElement="Flow_PensionReactivee_To_Notification_Reactivation">
        <di:waypoint x="790" y="1070" />
        <di:waypoint x="790" y="610" />
        <di:waypoint x="920" y="610" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Notification_To_End_Reactivation_di" bpmnElement="Flow_Notification_To_End_Reactivation">
        <di:waypoint x="1020" y="610" />
        <di:waypoint x="1100" y="610" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Association_Reactivation_di" bpmnElement="Association_Reactivation">
        <di:waypoint x="430" y="570" />
        <di:waypoint x="530" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>