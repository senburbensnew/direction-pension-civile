@startuml er_workflow_dossiers
!theme plain
skinparam linetype ortho
skinparam roundcorner 8
skinparam shadowing false
skinparam backgroundColor #FAFAFA

skinparam entity {
    BackgroundColor #FFFFFF
    BorderColor #4A90D9
    HeaderBackgroundColor #4A90D9
    HeaderFontColor #FFFFFF
    FontColor #333333
    FontSize 12
}

skinparam arrow {
    Color #666666
    FontColor #555555
    FontSize 10
}

title <b>Diagramme Entité-Association\nFlux de Traitement des Dossiers</b>

' ─────────────────────────────────────────────────────────────
'  ENTITÉ CENTRALE
' ─────────────────────────────────────────────────────────────
entity "**demandes**" as demandes {
    <b>PK</b>  id                  : BIGINT UNSIGNED        -- identifiant auto-incrémenté
    ---
        code                : VARCHAR(50) UNIQUE     -- référence unique générée (ex: DEM-2026-001)
        title               : VARCHAR(255)           -- titre / intitulé de la demande
        type                : VARCHAR(100)           -- TypeDemandeEnum (ex: PENSION_REQUEST)
        categorie           : VARCHAR(100) NULL      -- CategorieDossierEnum (ex: ADMINISTRATIF)
        is_urgent           : TINYINT(1) DEFAULT 0  -- 1 = dossier urgent (priorité haute)
        data                : JSON NULL              -- données spécifiques au type (champs variables)
        annotation          : TEXT NULL              -- note interne apposée par un agent
        circuit_snapshot    : JSON NULL              -- instantané du circuit au moment de la soumission
        folder              : VARCHAR(100) NULL      -- corbeille / répertoire d'archivage
        submitted_at        : TIMESTAMP NULL         -- date/heure de soumission officielle
        expires_at          : TIMESTAMP NULL         -- expiration du brouillon (72 h par défaut)
    <b>FK</b>  created_by          : BIGINT UNSIGNED        -- users.id — créateur (demandeur)
    <b>FK</b>  current_service_id  : BIGINT UNSIGNED NULL   -- services.id — service en charge
    <b>FK</b>  current_step_id     : BIGINT UNSIGNED NULL   -- workflow_steps.id — étape courante
    <b>FK</b>  annotated_by        : BIGINT UNSIGNED NULL   -- users.id — auteur de l'annotation
        annotated_at        : TIMESTAMP NULL         -- date/heure de l'annotation
        created_at          : TIMESTAMP
        updated_at          : TIMESTAMP
}

' ─────────────────────────────────────────────────────────────
'  ÉTAPES DU WORKFLOW
' ─────────────────────────────────────────────────────────────
entity "**workflow_steps**" as wf_steps {
    <b>PK</b>  id           : BIGINT UNSIGNED    -- identifiant auto-incrémenté
    ---
        code         : VARCHAR(100) UNIQUE  -- code métier (SOUMISE, EN_COURS, APPROUVEE …)
        nom          : VARCHAR(255)         -- libellé affiché à l'interface
        description  : TEXT NULL           -- rôle et attributions de l'étape
        type_noeud   : ENUM                -- INITIATEUR | INTERMEDIAIRE | TERMINAISON
        type_demande : VARCHAR(100) NULL   -- TypeDemandeEnum concerné (NULL = global)
        ordre        : INT DEFAULT 0       -- ordre d'affichage dans le circuit
    <b>FK</b>  service_id   : BIGINT UNSIGNED NULL -- services.id — service propriétaire de l'étape
        created_at   : TIMESTAMP
        updated_at   : TIMESTAMP
}

' ─────────────────────────────────────────────────────────────
'  RÈGLES DE TRANSITION ENTRE ÉTAPES
' ─────────────────────────────────────────────────────────────
entity "**workflow_step_transitions**" as wf_transitions {
    <b>PK</b>  id                  : BIGINT UNSIGNED       -- identifiant auto-incrémenté
    ---
    <b>FK</b>  from_step_id        : BIGINT UNSIGNED NULL   -- workflow_steps.id — étape source
    <b>FK</b>  to_step_id          : BIGINT UNSIGNED        -- workflow_steps.id — étape destination
        action              : VARCHAR(255)           -- libellé de l'action (ex: "Transférer au contrôle")
        is_urgent_only      : TINYINT(1) DEFAULT 0  -- 1 = réservé aux dossiers urgents
        ordre               : INT DEFAULT 0          -- ordre d'affichage dans le menu d'actions
        required_permission : VARCHAR(255) NULL      -- slug Spatie permission requis
        guard_conditions    : JSON NULL              -- {docs_complets, avis_complets, avis_favorables}
        created_at          : TIMESTAMP
        updated_at          : TIMESTAMP
}

' ─────────────────────────────────────────────────────────────
'  HISTORIQUE DES TRANSFERTS INTER-SERVICES
' ─────────────────────────────────────────────────────────────
entity "**demande_workflows**" as dw {
    <b>PK</b>  id                   : BIGINT UNSIGNED       -- identifiant auto-incrémenté
    ---
    <b>FK</b>  demande_id           : BIGINT UNSIGNED        -- demandes.id
    <b>FK</b>  from_service_id      : BIGINT UNSIGNED NULL   -- services.id — service émetteur
    <b>FK</b>  to_service_id        : BIGINT UNSIGNED        -- services.id — service récepteur
    <b>FK</b>  action_by_user_id    : BIGINT UNSIGNED        -- users.id — agent qui déclenche le transfert
        commentaire          : TEXT NULL             -- motif / observation du transfert
        reception_status     : ENUM DEFAULT 'pending' -- pending | accepted | refused
        reception_motif      : TEXT NULL             -- raison du refus ou note de réception
        reception_at         : TIMESTAMP NULL        -- date/heure de la décision de réception
    <b>FK</b>  reception_by_user_id : BIGINT UNSIGNED NULL   -- users.id — agent qui confirme la réception
        created_at           : TIMESTAMP
        updated_at           : TIMESTAMP
}

' ─────────────────────────────────────────────────────────────
'  JOURNAL DES CHANGEMENTS DE STATUT
' ─────────────────────────────────────────────────────────────
entity "**demande_histories**" as dh {
    <b>PK</b>  id          : BIGINT UNSIGNED    -- identifiant auto-incrémenté
    ---
    <b>FK</b>  demande_id  : BIGINT UNSIGNED     -- demandes.id
        statut      : VARCHAR(100)       -- code statut au moment du changement (ex: SOUMISE)
        commentaire : TEXT NULL         -- justification du changement de statut
        data        : JSON NULL         -- instantané des données de la demande à cet instant
    <b>FK</b>  changed_by  : BIGINT UNSIGNED NULL -- users.id — auteur du changement
        created_at  : TIMESTAMP
        updated_at  : TIMESTAMP
}

' ─────────────────────────────────────────────────────────────
'  DEMANDES D'AVIS AUX SERVICES
' ─────────────────────────────────────────────────────────────
entity "**affectations**" as affectations {
    <b>PK</b>  id                   : BIGINT UNSIGNED        -- identifiant auto-incrémenté
    ---
    <b>FK</b>  demande_id           : BIGINT UNSIGNED         -- demandes.id
    <b>FK</b>  service_id           : BIGINT UNSIGNED         -- services.id — service consulté pour avis
    <b>FK</b>  affecte_par_user_id  : BIGINT UNSIGNED         -- users.id — agent demandeur de l'avis
        statut               : ENUM DEFAULT 'EN_ATTENTE'  -- EN_ATTENTE | EN_COURS | TERMINE | REJETE
        avis                 : TEXT NULL               -- texte de l'avis rendu par le service
        date_affectation     : TIMESTAMP               -- date de création de la demande d'avis
        date_reponse         : TIMESTAMP NULL          -- date de rendu de l'avis
        created_at           : TIMESTAMP
        updated_at           : TIMESTAMP
}

' ─────────────────────────────────────────────────────────────
'  ASSIGNATION D'UN DOSSIER À UN AGENT
' ─────────────────────────────────────────────────────────────
entity "**assignments**" as assignments {
    <b>PK</b>  id          : BIGINT UNSIGNED     -- identifiant auto-incrémenté
    ---
    <b>FK</b>  demande_id  : BIGINT UNSIGNED      -- demandes.id
    <b>FK</b>  user_id     : BIGINT UNSIGNED      -- users.id — agent assigné au dossier
    <b>FK</b>  service_id  : BIGINT UNSIGNED      -- services.id — service de l'agent
    <b>FK</b>  assigned_by : BIGINT UNSIGNED      -- users.id — responsable qui fait l'assignation
        note        : TEXT NULL          -- instruction ou note à l'attention de l'agent
        ended_at    : TIMESTAMP NULL     -- fin d'assignation (NULL = assignation en cours)
        created_at  : TIMESTAMP
        updated_at  : TIMESTAMP
}

' ─────────────────────────────────────────────────────────────
'  DOCUMENTS REQUIS PAR SERVICE/TYPE
' ─────────────────────────────────────────────────────────────
entity "**step_required_documents**" as step_docs {
    <b>PK</b>  id            : BIGINT UNSIGNED     -- identifiant auto-incrémenté
    ---
    <b>FK</b>  service_id    : BIGINT UNSIGNED      -- services.id — service exigeant le document
        type_demande  : VARCHAR(100) NULL    -- TypeDemandeEnum concerné (NULL = tous les types)
        label         : VARCHAR(255)         -- libellé du document (ex: "Acte de naissance")
        document_type : VARCHAR(100)         -- collection Spatie Media (ex: acte_naissance)
        created_at    : TIMESTAMP
        updated_at    : TIMESTAMP
}

' ─────────────────────────────────────────────────────────────
'  SERVICES INTERNES
' ─────────────────────────────────────────────────────────────
entity "**services**" as services {
    <b>PK</b>  id          : BIGINT UNSIGNED    -- identifiant auto-incrémenté
    ---
        code        : VARCHAR(50) UNIQUE   -- code court (DIRECTION, LIQUIDATION, CONTROLE …)
        nom         : VARCHAR(255)         -- nom complet du service
        description : TEXT NULL           -- rôle et attributions du service
        icon        : VARCHAR(100) NULL    -- identifiant icône (Heroicons / FontAwesome)
        color       : VARCHAR(50) NULL     -- couleur Tailwind CSS pour l'affichage
        created_at  : TIMESTAMP
        updated_at  : TIMESTAMP
}

' ─────────────────────────────────────────────────────────────
'  TRANSITIONS DE FLUX LEGACY (service → service)
' ─────────────────────────────────────────────────────────────
entity "**flux_transitions**" as flux {
    <b>PK</b>  id                     : BIGINT UNSIGNED       -- identifiant auto-incrémenté
    ---
    <b>FK</b>  service_source_id      : BIGINT UNSIGNED        -- services.id — service émetteur
    <b>FK</b>  service_destination_id : BIGINT UNSIGNED        -- services.id — service récepteur
        action                 : VARCHAR(255)           -- libellé de l'action de transfert
        type_demande           : VARCHAR(100) NULL       -- TypeDemandeEnum concerné (NULL = tous)
        is_urgent_only         : TINYINT(1) DEFAULT 0   -- 1 = réservé aux dossiers urgents
        ordre                  : INT DEFAULT 0           -- ordre d'affichage dans la liste
        created_at             : TIMESTAMP
        updated_at             : TIMESTAMP
}

' ─────────────────────────────────────────────────────────────
'  UTILISATEURS (référence)
' ─────────────────────────────────────────────────────────────
entity "**users**" as users {
    <b>PK</b>  id         : BIGINT UNSIGNED     -- identifiant auto-incrémenté
    ---
        name       : VARCHAR(255)        -- nom complet de l'utilisateur
        email      : VARCHAR(255) UNIQUE -- adresse email (identifiant de connexion)
        type       : VARCHAR(50)         -- UserTypeEnum : Pensionnaire | Fonctionnaire | Institution
    <b>FK</b>  service_id : BIGINT UNSIGNED NULL  -- services.id — service de rattachement (agents seulement)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
}

' ─────────────────────────────────────────────────────────────
'  RELATIONS
' ─────────────────────────────────────────────────────────────

' Demande — clés étrangères directes
users    ||--o{ demandes       : "crée (created_by)"
services ||--o{ demandes       : "en charge (current_service_id)"
wf_steps ||--o{ demandes       : "étape courante (current_step_id)"
users    ||--o{ demandes       : "annote (annotated_by)"

' Demande — entités enfants
demandes ||--o{ dw             : "transferts inter-services"
demandes ||--o{ dh             : "historique des statuts"
demandes ||--o{ affectations   : "demandes d'avis"
demandes ||--o{ assignments    : "assignations d'agents"

' Étapes du workflow
services ||--o{ wf_steps       : "possède les étapes (service_id)"
wf_steps ||--o{ wf_transitions : "from_step (source)"
wf_steps ||--o{ wf_transitions : "to_step (destination)"

' Transferts inter-services
services ||--o{ dw             : "émet (from_service_id)"
services ||--o{ dw             : "reçoit (to_service_id)"
users    ||--o{ dw             : "déclenche (action_by_user_id)"
users    ||--o{ dw             : "confirme réception (reception_by_user_id)"

' Historique
users    ||--o{ dh             : "modifie (changed_by)"

' Affectations pour avis
services ||--o{ affectations   : "consulté pour avis (service_id)"
users    ||--o{ affectations   : "demande l'avis (affecte_par_user_id)"

' Assignation agents
users    ||--o{ assignments    : "assigné au dossier (user_id)"
services ||--o{ assignments    : "service de l'agent (service_id)"
users    ||--o{ assignments    : "assigne (assigned_by)"

' Documents requis
services ||--o{ step_docs      : "exige des documents (service_id)"

' Flux legacy
services ||--o{ flux           : "source (service_source_id)"
services ||--o{ flux           : "destination (service_destination_id)"

' Agents rattachés à un service
services ||--o{ users          : "emploie (service_id)"

@enduml
