APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- DATABASE ---
# Active driver: mysql (switch: composer db:mysql | composer db:sqlite)
# Tests (php artisan test) use SQLite :memory: via phpunit.xml — not this connection.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portail_dpc
DB_USERNAME=app
DB_PASSWORD=password123
# --- END DATABASE ---

MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# file (défaut) ou database (recommandé en prod — voir migration sessions + admin Sessions actives)
SESSION_DRIVER=file
SESSION_LIFETIME=30
PASSWORD_CONFIRM_TIMEOUT=900

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local : log. Docker Sail/Mailpit : smtp + mailpit. Mailpit sur la machine : smtp + 127.0.0.1
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

OCR_DRIVER=google_document_ai
OCR_TESSERACT_BINARY=tesseract
OCR_LANGUAGE=fra+eng
OCR_TESSERACT_PSM=6
OCR_TIMEOUT=60

# google | google_vision | google_document_ai
OCR_GOOGLE_API_KEY=
OCR_GOOGLE_CREDENTIALS=secrets/ocr-dpc-sa.json
OCR_GOOGLE_PROJECT_ID=
OCR_GOOGLE_LOCATION=us
OCR_GOOGLE_PROCESSOR_ID=
# OCR_GOOGLE_DOCUMENT_AI_ENDPOINT=https://us-documentai.googleapis.com
# Fichier CA pour cURL (Windows / PHP sans curl.cainfo) : storage/certs/cacert.pem
OCR_GOOGLE_CA_BUNDLE=

RDV_JITSI_DOMAIN=meet.jit.si

# Newsletter
NEWSLETTER_DOUBLE_OPT_IN=true
NEWSLETTER_CONFIRMATION_TTL_HOURS=48
NEWSLETTER_SUBSCRIBE_RATE_LIMIT=5
NEWSLETTER_BATCH_SIZE=50
NEWSLETTER_FROM_NAME="${MAIL_FROM_NAME}"
NEWSLETTER_REPLY_TO="${MAIL_FROM_ADDRESS}"
NEWSLETTER_OPEN_TRACKING=false
NEWSLETTER_CLICK_TRACKING=false
NEWSLETTER_WEBHOOK_SECRET=
